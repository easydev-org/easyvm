walkthrough "android 13 (blissos 16.9.7) - start the installed disk"
resolution 1920x1080
recording_resolution 1920x1080
var boot_timeout
  default "600"
  from args.boot_timeout
var out
  default out/blissos16-launch.qcow2
  from args.out


step "boot the installed disk"
  boot
  memory_mb 4096
  os android
  timeout 300

step "the firmware found the ESP and GRUB is running"
  repeat
    pause 5
    until
      bind reached
      source boot
      mode text
      rect [548, 689, 1184, 868]
      rect_at [1920, 1080]
      words [[blissos], [android], [grub]]
    max 60

step "wait for the home-app chooser"
  repeat
    pause 5
    until
      bind asked
      source chooser
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [home, app]
    max 20

step "choose Taskbar for Bliss OS"
  input 666 722
  settle 3

step "always, so the next boot goes straight to the desktop"
  input 1238 986
  settle 6

step "wait for Android's own UI"
  desktop android
  poll 10
  timeout "{{ boot_timeout }}"

step "stop the machine"
  stop kill
  timeout 120
