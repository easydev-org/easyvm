walkthrough "android 13 (blissos 16.9.7) - start the installed disk"
  resolution 1920x1080
  var boot_timeout == {default: "600", from: args.boot_timeout}
  var out == {default: out/blissos16-launch.qcow2, from: args.out}
  header recording_resolution == [1920, 1080]

  step "boot the installed disk"
    boot == true
    memory_mb == 4096
    os == android
    timeout == 300
  step "the firmware found the ESP and GRUB is running"
    loop == {check: {from: boot, mode: text, name: reached, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [[blissos], [android], [grub]]}, do: [{settle: 5}], max: 60, see: {name: boot}, until: {fact: reached}}
  step "wait for the home-app chooser"
    loop == {check: {from: chooser, mode: text, name: asked, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [home, app]}, do: [{settle: 5}], max: 20, see: {name: chooser}, until: {fact: asked}}
  click "choose Taskbar for Bliss OS" at 666 722, waiting 3s, named "choose Taskbar for Bliss OS"
  click "always, so the next boot goes straight to the desktop" at 1238 986, waiting 6s, named "always, so the next boot goes straight to the desktop"
  step "wait for Android's own UI"
    desktop == android
    poll == 10
    timeout == '{{ boot_timeout }}'
  step "stop the machine"
    shutdown == kill
    timeout == 120
