walkthrough "android 13 (blissos 16.9.7) - install onto a disk this file makes"
resolution 1920x1080
recording_resolution 1920x1080
var disk_gb
  default "128"
  from args.disk_gb
var esp_mib
  default "260"
  from args.esp_mib
var out
  default out/blissos16.qcow2
  from args.out

step "the media this stage boots from is already on disk"
  needs [blissos-16.9.7.iso]

step "give the installer a disk with its ESP already there"
  disk disk.qcow2
  disk_esp_mib "{{ esp_mib }}"
  disk_gb "{{ disk_gb }}"
  disk_gpt

step "boot the installer"
  boot
  iso blissos-16.9.7.iso
  memory_mb 4096
  os android
  timeout 900

step "let the menu draw"
  settle 20

step "read the menu"
  read
    name menu

step "the menu offers Installation"
  check
    source menu
    mode text
    name has_install
    rect [816, 507, 965, 571]
    rect_at [1920, 1080]
    words [installation]

step "down to the second row"
  press down
  settle 1

step "down to the third row"
  press down
  settle 1

step "down to the fourth row"
  press down
  settle 1

step "down to Installation"
  press down
  settle 1

step "start the installer"
  press ret
  settle 45

step "open the ESP's filesystem question"
  press ret
  settle 15

step "choose FAT32"
  press f
  settle 3

step "confirm the filesystem"
  press ret
  settle 10

step "keep the ESP label"
  press ret
  settle 12

step "select Yes for the ESP format"
  press left
  settle 2

step "format the ESP"
  press ret
  settle 30

step "move to the system partition"
  press down
  settle 3

step "open vda2"
  press ret
  settle 15

step "choose ext4"
  press e
  settle 3

step "confirm the filesystem for vda2"
  press ret
  settle 10

step "keep the system volume label"
  press ret
  settle 12

step "select Yes for the system format"
  press left
  settle 2

step "format vda2 and copy the system"
  press ret
  settle 300

step "decline the OTA preparation"
  press right
  settle 3

step "confirm the OTA answer"
  press ret
  settle 40

step "write Grub2 into the ESP"
  press ret
  settle 200

step "read the result"
  read
    name done

step "it says the install succeeded"
  check
    source done
    mode text
    name installed
    rect [818, 392, 1033, 453]
    rect_at [1920, 1080]
    words [[congratulations], [successfully]]

step "stop the installer"
  stop kill
  timeout 120

step "copy the loader to the UEFI fallback path"
  esp_fallback
    disk disk
    from /EFI/BLISSOS

step "publish the disk"
    save "{{ out }}"
