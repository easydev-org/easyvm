walkthrough "endeavouros - install to ext4, then the power button"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/endeavouros.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [endeavour.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso endeavour.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  desktop linux/kde
  poll 5
  range [0.9, 1]
  # THE TOP 120 ROWS ARE WALLPAPER AND A MENU BAR: a boot splash scores 0.0002
  # there and every desktop frame 1.0000, including the ones with an installer
  # window over the middle. The clock sits below this band, which is why 120.
  rect [0, 0, 1920, 120]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "let the desktop settle"
  settle 15


step "start the installer"
  input 748 431
  settle 25


step "choose the offline method"
  input 1084 591
  settle 30


step "calamares is up"
  read
    name cal


step "the welcome page is in English or needs changing"
  check
    source cal
    mode text
    name seen
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[welcome], [歡迎]]


step "open the language list"
  input 980 661
  settle 4


step "jump to the English group"
  input e
  settle 2


step "step up to British English"
  input up
  settle 1


step "step up to American English"
  input up
  settle 1


step "choose it"
  input ret
  settle 6


step "the installer speaks English"
  read
    name english


step "the page is in English"
  check
    source english
    mode text
    name ok
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[welcome]]


step "next from welcome"
  input 1410 878
  settle 9


step "next from location"
  input 1410 878
  settle 9


step "next from keyboard"
  input 1410 878
  settle 9


step "the bootloader page"
  read
    name boot


step "next from bootloader"
  input 1410 878
  settle 9


step "the partitions page"
  read
    name parts


step "select erase disk"
  input 679 252
  settle 8


step "the partitions page with erase selected"
  read
    name erase


step "the default filesystem is ext4"
  check
    source erase
    mode text
    name ext4
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[ext4]]


step "next from partitions"
  input 1410 878
  settle 10


step "the users page settles before anything is typed into it"
  repeat
    pause 8
    until
      bind here
      source at_users
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[Reuse]]
    max 24


step "the users page"
  read
    name users


step "the full name"
  input text "{{ user }}"
    at 850 299
  settle 2


step "the login name - click the field"
  input 850 354


step "the login name - select what is there"
  input ctrl+a
  settle 1


step "the login name - delete the selection"
  input backspace
  settle 1


step "the login name - type the value"
  input text "{{ user }}"
  settle 2

step "the computer name - click the field"
  input 850 434


step "the computer name - select what is there"
  input ctrl+a
  settle 1


step "the computer name - delete the selection"
  input backspace
  settle 1


step "the computer name - type the value"
  input text endeavouros
  settle 2

step "the password"
  input text "{{ password }}"
    at 700 515
  settle 2

  # THE ROOT PASSWORD IS TYPED INTO ITS FIELDS RATHER THAN TICKED BY A CHECKBOX.
  #
  # THE CHECKBOX WAS TRIED TWICE AND MEASURED TO FAIL BOTH TIMES. The frame from run 44447463692
  # shows "Reuse user password as root password" still UNCHECKED with the Root password and Repeat
  # root password fields EMPTY, after six clicks at the box's own centre (584, 648) and six at the
  # label (700, 648). Calamares' Qt checkbox toggles on the indicator and ignores the label, and the
  # indicator is 14 px wide - one repaint from being missed.
  #
  # A FORM FIELD IS 300 px WIDE AND CANNOT BE MISSED, and it is what the checkbox would have filled
  # anyway: the label says "reuse the user password for root", so the value to type is the same one.
  #
  # `clear: true` first, because a half-filled field from a click that landed in it is worse than an
  # empty one - Calamares shows the mismatch and keeps Next disabled either way.

step "the password again - click the field"
  input 900 515


step "the password again - select what is there"
  input ctrl+a
  settle 1


step "the password again - delete the selection"
  input backspace
  settle 1


step "the password again - type the value"
  input text "{{ password }}"
  settle 2

step "the root password - first field - click the field"
  input 700 703


step "the root password - first field - select what is there"
  input ctrl+a
  settle 1


step "the root password - first field - delete the selection"
  input backspace
  settle 1


step "the root password - first field - type the value"
  input text "{{ password }}"
  settle 2

step "the root password - second field - click the field"
  input 993 703


step "the root password - second field - select what is there"
  input ctrl+a
  settle 1


step "the root password - second field - delete the selection"
  input backspace
  settle 1


step "the root password - second field - type the value"
  input text "{{ password }}"
  settle 2

step "log in automatically"
  input 587 755
  settle 3


step "the users page is filled in"
  read
    name filled


step "the password was accepted"
  check
    source filled
    mode text
    name ok
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    without [match]
    words [ok]


step "next from users"
  input 1410 878
  settle 10


step "the summary page arrives before install is clicked"
  repeat
    pause 10
    until
      bind here
      source settle
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[summary], [install]]
    max 30


step "the summary page"
  read
    name summary


step "the summary names ext4"
  check
    source summary
    mode text
    name ext4
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[ext4]]


step "start the install"
  input 1412 868
  settle 10


step "the confirmation dialog"
  read
    name confirm


step "install now"
  input 1064 540
  settle 25


step "the install writes the disk"
  disk_min_mb 4000
  disk_settle 300
  poll 20
  timeout 3600


step "the install is done"
  repeat
    pause 15
    until
      bind finished
      source done
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[installed]]
    max 80


step "stop the machine"
  stop kill
  timeout 600


step "publish the disk"
    save "{{ out }}"
