walkthrough "endeavouros - install to ext4, then the power button"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/endeavouros.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [endeavour.iso]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the installer"
  boot
  iso endeavour.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800

step "wait for the live desktop"
  desktop linux/kde
  poll 5
  range [0.9, 1]
  # THE TOP 120 ROWS ARE WALLPAPER AND A MENU BAR: a boot splash scores 0.0002
  # there and every desktop frame 1.0000, including the ones with an installer
  # window over the middle. The clock sits below this band, which is why 120.
  rect [0, 0, 1920, 120]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400

step "let the desktop settle"
  settle 15

step "start the installer"
  press 748 431
  settle 25

step "choose the offline method"
  press 1084 591
  settle 30

step "calamares is up"
  read
    name cal

step "the welcome page is in English or needs changing"
  expect
    from cal
    mode text
    name seen
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[welcome], [歡迎]]

step "open the language list"
  press 980 661
  settle 4

step "jump to the English group"
  press e
  settle 2

step "step up to British English"
  press up
  settle 1

step "step up to American English"
  press up
  settle 1

step "choose it"
  press ret
  settle 6

step "the installer speaks English"
  read
    name english

step "the page is in English"
  expect
    from english
    mode text
    name ok
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[welcome]]

step "next from welcome"
  press 1410 878
  settle 9

step "next from location"
  press 1410 878
  settle 9

step "next from keyboard"
  press 1410 878
  settle 9

step "the bootloader page"
  read
    name boot

step "next from bootloader"
  press 1410 878
  settle 9

step "the partitions page"
  read
    name parts

step "select erase disk"
  press 679 252
  settle 8

step "the partitions page with erase selected"
  read
    name erase

step "the default filesystem is ext4"
  expect
    from erase
    mode text
    name ext4
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[ext4]]

step "next from partitions"
  press 1410 878
  settle 10

step "the users page settles before anything is typed into it"
  repeat
    pause 8
    until
      bind here
      from at_users
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[Reuse]]
    max 24

step "the users page"
  read
    name users

step "the full name"
  press text "{{ user }}"
    at 850 299
  settle 2

step "the login name"
  clear
  press text "{{ user }}"
    at 850 354
  settle 2

step "the computer name"
  clear
  press text endeavouros
    at 850 434
  settle 2

step "the password"
  press text "{{ password }}"
    at 700 515
  settle 2

step "the password again"
  clear
  press text "{{ password }}"
    at 900 515
  settle 2

  # THE ROOT PASSWORD IS TYPED INTO ITS FIELDS RATHER THAN TICKED BY A CHECKBOX.
  #
  # THE CHECKBOX WAS TRIED TWICE AND MEASURED TO FAIL BOTH TIMES. The frame from run 44447463692
  # shows "Reuse user password as root password" still UNCHECKED with the Root password and Repeat
  # root password fields EMPTY, after six clicks at the box's own centre (584, 648) and six at the
  # label (700, 648). Calamares' Qt checkbox toggles on the indicator and ignores the label, and the
  # indicator is 14 px wide - one repaint from being missed.
  #
  # A FORM FIELD IS 300 px WIDE AND CANNOT BE MISSED, and it is what the checkbox would have filled
  # anyway: the label says "reuse the user password for root", so the value to type is the same one.
  #
  # `clear: true` first, because a half-filled field from a click that landed in it is worse than an
  # empty one - Calamares shows the mismatch and keeps Next disabled either way.
step "the root password - first field"
  clear
  press text "{{ password }}"
    at 700 703
  settle 2

step "the root password - second field"
  clear
  press text "{{ password }}"
    at 993 703
  settle 2

step "log in automatically"
  press 587 755
  settle 3

step "the users page is filled in"
  read
    name filled

step "the password was accepted"
  expect
    from filled
    mode text
    name ok
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    without [match]
    words [ok]

step "next from users"
  press 1410 878
  settle 10

step "the summary page arrives before install is clicked"
  repeat
    pause 10
    until
      bind here
      from settle
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[summary], [install]]
    max 30

step "the summary page"
  read
    name summary

step "the summary names ext4"
  expect
    from summary
    mode text
    name ext4
    rect [570, 225, 1340, 745]
    rect_at [1920, 1080]
    scale 2
    words [[ext4]]

step "start the install"
  press 1412 868
  settle 10

step "the confirmation dialog"
  read
    name confirm

step "install now"
  press 1064 540
  settle 25

step "the install writes the disk"
  disk_min_mb 4000
  disk_settle 300
  poll 20
  timeout 3600

step "the install is done"
  repeat
    pause 15
    until
      bind finished
      from done
      mode text
      rect [570, 225, 1340, 745]
      rect_at [1920, 1080]
      scale 2
      words [[installed]]
    max 80

step "stop the machine"
  stop kill
  timeout 600

step "publish the disk"
    save "{{ out }}"
