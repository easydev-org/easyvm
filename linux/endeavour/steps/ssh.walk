walkthrough "linux-endeavour - sshd"
  resolution 1920x1080
  password admin
  var out == {default: out/distro.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  step "boot the disk"
    boot == true
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 900
  click "greeter - the password box" at 936 628, waiting 3s, named "greeter - the password box"
  step "greeter - log in"
    settle == 3
    type == '{{ password }}'
  press Return, waiting 12s, named "greeter - submit"
  press ctrl+alt+t, waiting 20s, named "open the terminal"
  step "keep the screen on, because a blanked screen takes no keys"
    run == xset s off; xset -dpms; xset s noblank; echo SCREEN_KEPT_ON
    settle == 5
    terminal_wait == 20
  step "install openssh"
    run == echo {{ password }} | sudo -S pacman -Sy --noconfirm --needed openssh 2>&1 | tail -5
    settle == 45
    terminal_wait == 0
  step "allow password authentication"
    run == echo {{ password }} | sudo -S -p '' sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf "PasswordAuthentication yes\n" > /etc/ssh/sshd_config.d/99-vm.conf; sed -i "s/^#\?\s*PasswordAuthentication.*/PasswordAuthentication yes/" /etc/ssh/sshd_config; grep -q "^PasswordAuthentication yes" /etc/ssh/sshd_config || printf "PasswordAuthentication yes\n" >> /etc/ssh/sshd_config' 2>&1 | tail -3
    settle == 3
    terminal_wait == 0
  step "enable sshd at boot"
    run == echo {{ password }} | sudo -S systemctl enable sshd 2>&1 | tail -3
    settle == 8
    terminal_wait == 0
  step "start sshd"
    run == echo {{ password }} | sudo -S systemctl restart sshd 2>&1 | tail -3
    settle == 10
    terminal_wait == 0
  step "prove sshd is active"
    run == systemctl is-active sshd
    settle == 5
    terminal_wait == 0
  step "wait for sshd"
    require_ssh == true
    timeout == 600
  step "prove the kernel over ssh"
    ssh == uname -a
    timeout == 120
  step "prove the account over ssh"
    ssh == id -un; hostname
    timeout == 120
  step "ask the guest to power off"
    ssh == printf '%s\n' '{{ password }}' | sudo -S -p '' poweroff
    timeout == 300
  step "wait for the machine to stop"
    timeout == 300
    wait_until == stopped
  step "publish the disk"
    compress == '{{ out }}'
