walkthrough "linux-mx - sshd"
  resolution 1920x1080
  password admin
  var out == {default: out/distro.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  step "boot the disk"
    boot == true
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 900
  # THIS DISK COMES UP IN A GRUB SHELL, AND `normal` IS WHAT LEAVES IT.
  #
  # MEASURED ON RUN 44557862904's mx successor, whose ssh recording is
  #
  #	Welcome to MX-Linux!
  #	grub> grub> grub> grub> ...   (forty of them, cursor at the last)
  #
  # A bare `grub>` prompt means grub.efi ran but its own menu was not found or failed - not the same
  # as the menu that endeavour and manjaro stop at. `normal` asks grub to load its normal module and
  # its menu; on a disk whose /boot/grub/grub.cfg exists this lands on the menu, and the Return after
  # it boots the first entry.
  #
  # The words are the shell's own prompt, so a disk that boots straight through is unaffected.
  step "grub shell, when the disk drops into one"
    loop == {check: {from: shell, mode: text, name: at_shell, rect: [450, 170, 1470, 900], rect_at: [1920, 1080], scale: 1, words: [[grub]]}, do: [{settle: 4}], max: 6, see: {name: shell}, until: {fact: at_shell}}
    optional == true
  step "leave the shell for the menu"
    when == [grub]
    type == normal
    settle == 3
  press Return, waiting 5s, named "enter the normal module, which loads the menu"
  press Return, waiting 25s, named "boot the highlighted entry, which is the installed system"
  # THE GREETER IS ASKED FOR BEFORE IT IS CLICKED, AND THE BAND IS THIS MEDIUM'S OWN.
  #
  # THIS FILE HAD MINT'S BAND ([80,480,480,640] - LightDM's small card) BECAUSE THE TWO WALKS WERE
  # EDITED TOGETHER, AND MX DOES NOT DRAW THAT: it runs SDDM, whose user tile and password field sit
  # in the middle of the screen, which is the band cachyos, endeavour and manjaro use.
  #
  # The click below is at 259,568 - LightDM's position - so it is moved to SDDM's field as well.
  # MEASURED on this medium's own install recording, whose greeter is the same SDDM.
  step "the greeter is drawn"
    loop == {check: {from: greeter, mode: text, name: up, rect: [740, 470, 1340, 770], rect_at: [1920, 1080], scale: 2, words: [[password], [vmuser]]}, do: [{key: esc, settle: 3}], max: 60, see: {name: greeter}, until: {fact: up}}
  click "greeter - the password box" at 936 628, waiting 2s, optionally, named "greeter - the password box"

  step "greeter - log in"
    optional == true
    settle == 3
    type == '{{ password }}'
  step "greeter - submit"
    key == ret
    optional == true
    settle == 12
  # THE SESSION TAKES LONGER THAN THE TWELVE SECONDS AFTER `Return`, AND A CHORD PRESSED IN THAT
  # GAP GOES TO THE GREETER. This is the same gate the same medium's install walk uses.
  step "wait for the desktop"
    desktop == linux/xfce
    timeout == 900
  press ctrl+alt+t, waiting 20s, named "open the terminal"
  # NO `terminal_wait:` HERE, AND THAT IS THE FIX RATHER THAN AN OMISSION.
  #
  # `terminal_wait:` OPENS A TERMINAL (ctrl+alt+t) AND THEN TYPES. The step above has already
  # opened one, so a second ctrl+alt+t starts a NEW terminal window and the keys that follow go to
  # it - while the command already typed into the first one is never submitted.
  #
  # MEASURED ON RUN 44545555943's kubuntu ssh recording, whose terminal shows exactly that:
  #
  #	vmuser@kubuntu:~$ xset s off; xset -dpms; xset s noblank; echo SCREEN_KEPT_ONECHO ADMIN | sudo ...
  #	server does not have extension for -dpms option
  #	[sudo: authenticate] Password:
  #
  # `SCREEN_KEPT_ON` runs straight into `ECHO ADMIN` with no line break: the Return after the first
  # command went to the OTHER window. And the `xset -dpms` failure - "server does not have extension
  # for -dpms option" - is harmless; the screen is still kept awake by `s off` and `s noblank`.
  step "install openssh-server"
    run == xset s off; xset s noblank; echo {{ password }} | sudo -S sh -c "export DEBIAN_FRONTEND=noninteractive; apt-get update -o DPkg::Lock::Timeout=600 && apt-get install -y -o DPkg::Lock::Timeout=600 openssh-server" 2>&1 | tail -6
    settle == 90
    terminal_wait == 0
  step "allow password authentication"
    run == echo {{ password }} | sudo -S -p '' sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf "PasswordAuthentication yes\n" > /etc/ssh/sshd_config.d/99-vm.conf; sed -i "s/^#\?\s*PasswordAuthentication.*/PasswordAuthentication yes/" /etc/ssh/sshd_config; grep -q "^PasswordAuthentication yes" /etc/ssh/sshd_config || printf "PasswordAuthentication yes\n" >> /etc/ssh/sshd_config' 2>&1 | tail -3
    settle == 3
    terminal_wait == 0
  step "enable ssh at boot (SysVinit)"
    run == echo {{ password }} | sudo -S update-rc.d ssh enable 2>&1 | tail -3
    settle == 8
    terminal_wait == 0
  step "prove the setting took"
    run == echo {{ password }} | sudo -S sh -c 'sshd -T 2>/dev/null | grep -i "^passwordauthentication" || echo PASSWORDAUTH-UNREADABLE' 2>&1 | tail -3
    settle == 3
    terminal_wait == 0
  step "start ssh (SysVinit)"
    run == echo {{ password }} | sudo -S service ssh start 2>&1 | tail -3
    settle == 10
    terminal_wait == 0
  step "prove ssh is running"
    run == echo {{ password }} | sudo -S service ssh status 2>&1 | tail -3
    settle == 5
    terminal_wait == 0
  step "open the firewall for ssh"
    run == echo {{ password }} | sudo -S sh -c "ufw allow 22/tcp; ufw status | head -6" 2>&1 | tail -8
    settle == 8
    terminal_wait == 0
  step "wait for sshd"
    require_ssh == true
    timeout == 600
  step "prove the kernel over ssh"
    ssh == uname -a
    timeout == 120
  step "prove the account over ssh"
    ssh == id -un; hostname
    timeout == 120
  step "ask the guest to power off"
    ssh == printf '%s\n' '{{ password }}' | sudo -S -p '' poweroff
    timeout == 300
  step "wait for the machine to stop"
    timeout == 300
    wait_until == stopped
  step "publish the disk"
    compress == '{{ out }}'
