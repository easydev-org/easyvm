walkthrough "mx - the minstall walk"
  resolution 1920x1080
  password admin
  var out == {default: out/distro.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  needs mx.iso, named "the media this stage boots from is already on disk"
  step "create the empty disk"
    disk == disk.qcow2
    disk_gb == 128
  step "boot the installer"
    boot == true
    iso == mx.iso
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 1800
  step "the medium's boot menu is up"
    see == name: mxmenu
  step "that menu is the language submenu this medium opens on"
    check == {from: mxmenu, mode: text, name: is_mx_menu, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[Language], [Keyboard], [Timezone]]}
  press Escape, waiting 4s, named "leave the language submenu for the real boot menu"
  press up, waiting 1s, named "up to the first entry, which is the live session"
  press up, waiting 1s, named "up again"
  press up, waiting 1s, named "and once more"
  press Return, waiting 25s, named "boot it"
  step "wait for the live desktop"
    desktop == linux/xfce
    timeout == 5400
  step "desktop - installer"
    do == [{click: [81, 259], settle: 3}, {click: [81, 259], settle: 3}]
    settle == 28
  step "wait for the terms page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [terms, of, use]}, do: [{settle: 6}], max: 30, see: {name: screen}, until: {fact: done}}
  click "terms of use" at 1482 889, waiting 14s, named "terms of use"
  step "wait for the installation type page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [select, type, of, installation]}, do: [{settle: 6}], max: 30, see: {name: screen}, until: {fact: done}}
  click installation at 1482 889, waiting 16s, named "installation type"
  step "wait for the confirmation page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [final, review]}, do: [{settle: 6}], max: 30, see: {name: screen}, until: {fact: done}}
  click "installation confirmation - start" at 1478 889, waiting 25s, named "installation confirmation - start"
  click "dismiss the invalid settings modal if it is up" at 1069 583, waiting 4s, named "dismiss the invalid settings modal if it is up"
  step "wait for the swap file page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [create, a, swap, file]}, do: [{settle: 6}], max: 40, see: {name: screen}, until: {fact: done}}
  click swap at 1482 889, waiting 18s, named "swap file"
  step "wait for the computer identity page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [computer, identity]}, do: [{settle: 6}], max: 40, see: {name: screen}, until: {fact: done}}
  click computer at 1482 889, waiting 18s, named "computer identity"
  step "wait for the localization page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [localization, defaults]}, do: [{settle: 6}], max: 40, see: {name: screen}, until: {fact: done}}
  click localization at 1482 889, waiting 18s, named "localization defaults"
  step "wait for the account page"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [default, user, login]}, do: [{settle: 6}], max: 30, see: {name: screen}, until: {fact: done}}
  step "account - login name"
    click == [1210, 342]
    settle == 2
    type == '{{ user }}'
  step "account - password"
    click == [1210, 377]
    settle == 2
    type == '{{ password }}'
  step "account - confirm password"
    click == [1210, 412]
    settle == 3
    type == '{{ password }}'
  click autologin at 700 561, waiting 4s, named "autologin"
  click "default user login" at 1482 889, waiting 25s, named "default user login"
  step "the installer finishes"
    loop == {check: {from: screen, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [[congratulations], [completed, the, installation]]}, do: [{click: [420, 300], settle: 20}], max: 90, see: {name: screen}, until: {fact: done}}
  step "stop the machine"
    shutdown == kill
    timeout == 120
  step "publish the disk"
    compress == '{{ out }}'
