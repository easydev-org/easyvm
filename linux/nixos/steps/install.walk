walkthrough "nixos - the Calamares walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [nixos.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso nixos.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  desktop linux/gnome
  poll 5
  range [0.9, 1]
  # THE BAND IS TOP-RIGHT WALLPAPER: the clock is at the top centre and the search bar
  # sits under it, and an installer window covers the middle from y=295 down. Measured on this
  # medium's own recording: the boot splash scores 0.0000 here and every desktop frame 1.0000.
  rect [1500, 120, 1900, 280]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "open the installer"
  do
    item
      input 960 640
      settle 3
    item
      input 960 640
      settle 3
  settle 8


step "calamares is up"
  repeat
    do
      item
        input 420 300
        settle 10
    until
      bind done
      source screen
      mode text
      rect [810, 361, 978, 495]
      rect_at [1920, 1080]
      scale 3
      words [[welcome], [language], [keyboard]]
    max 30


step "the language combo, opened and taken"
  input 1050 736
  settle 3


step "take the current entry"
  input ret
  settle 3


step "next through the pages, until the users page is up"
  repeat
    do
      item
        input 1330 828
        settle 8
    until
      bind here
      source at_users
      mode text
      rect [637, 384, 1146, 526]
      rect_at [1920, 1080]
      scale 3
      words [[name], [Password]]
    max 8


step "the full name field - click the field"
  input 727 375


step "the full name field - select what is there"
  input ctrl+a
  settle 1


step "the full name field - delete the selection"
  input backspace
  settle 1


step "the full name field - type the value"
  input text "{{ user }}"


step "the full name field - the field took it"
  repeat
    do
      item
    until
      bind took
      source name_field
      mode text
      rect [626, 362, 829, 389]
      rect_at [1920, 1080]
      scale 8
      words [["{{ user }}"]]
    max 4
  settle 2

step "users - allow a short password"
  input 645 537
  settle 3


step "users - password"
  input text "{{ password }}"
    at 741 495
  settle 2


step "users - repeat password"
  input text "{{ password }}"
    at 959 495
  settle 2


step "users - administrator password"
  input text "{{ password }}"
    at 741 609
  settle 2


step "users - administrator repeat password"
  input text "{{ password }}"
    at 959 609
  settle 3


step "next to the partitions page"
  repeat
    do
      item
        input 1330 828
        settle 6
    until
      bind here
      source at_partitions
      mode text
      rect [680, 360, 860, 469]
      rect_at [1920, 1080]
      scale 3
      words [[partitioning], [erase]]
    max 8


step "partitions - erase the disk"
  input 633 390
  settle 6


step "partitions -> summary"
  repeat
    do
      item
        input 1330 828
        settle 6
    until
      bind here
      source at_summary
      mode text
      rect [662, 322, 763, 377]
      rect_at [1920, 1080]
      scale 3
      words [[overview]]
    max 6


step "summary - install"
  repeat
    do
      item
        input 1328 857
        settle 12
    until
      bind begun
      source summary_after
      mode text
      rect [602, 809, 703, 870]
      rect_at [1920, 1080]
      scale 3
      words [[Installing]]
    max 6


step "the install is written"
  disk_min_mb 1024
  disk_settle 180
  poll 20
  timeout 3600


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
