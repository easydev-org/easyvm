walkthrough "zorin - the ubiquity walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [zorin.iso]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the installer"
  boot
  iso zorin.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800

step "wait for the live desktop"
  desktop linux/gnome
  range [0.9, 1]
  # THE TOP 120 ROWS ARE WALLPAPER AND A MENU BAR: a boot splash scores 0.0002
  # there and every desktop frame 1.0000, including the ones with an installer
  # window over the middle. The clock sits below this band, which is why 120.
  rect [0, 0, 1920, 120]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400

  # THE LIVE SESSION OPENS A WELCOME DIALOG, AND `desktop: linux/gnome` CAN PASS BEFORE IT IS DRAWN.
  #
  # MEASURED ON RUN 44350350968: after ninety minutes the frame was the bare Zorin wallpaper - no
  # installer window, no welcome dialog - and the loop below had asked 120 times whether one was up.
  # The desktop predicate decides on brightness, variance and saturation; a wall paper satisfies all
  # three, so it passed while the session was still starting.
  #
  # SO THE FIRST STRETCH OF THE WAIT PRESSES RETURN, because the welcome dialog is modal and takes
  # the key: that is how the same live session is driven by hand. Then the text check decides.
step "wake the live session, whose welcome dialog takes a key"
  press ret
  settle 20

step "wake it again"
  press ret
  settle 20

step "wake it again"
  press ret
  settle 20

step "wait for the installer to put itself up"
  repeat
    do
      item
        settle 5
      item
        press ret
      item
        settle 5
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 2
      words [[install, zorin], [try, zorin], [welcome], [false, localization]]
    max 120

step "install zorin os"
  do
    item
      press 1223 586
      settle 3
    item
      press 1223 586
      settle 3
  settle 40

step "install zorin os (once more, if the wizard is not up)"
  do
    item
      press 1223 586
      settle 3
    item
      press 1223 586
      settle 3
  settle 40
  when_not [keyboard]

step "disable the screen saver and the lock"
  run "xrandr --output Virtual-1 --mode 1920x1080 2>/dev/null || xrandr --output Virtual1 --mode 1920x1080 2>/dev/null || xrandr -s 1920x1080 2>/dev/null || true; xset s off; xset -dpms; xset s noblank; gsettings set org.gnome.desktop.session idle-delay 0; gsettings set org.gnome.desktop.screensaver lock-enabled false; ( for i in $(seq 1 1080); do xdotool mousemove_relative -- 1 0 2>/dev/null; xdotool mousemove_relative -- -1 0 2>/dev/null; sleep 20; done ) >/dev/null 2>&1 & exit"
  settle 10
  terminal_wait 8
  type_gap 0.15

step "welcome"
  press 1361 764
  settle 15

step "keyboard - english (us)"
  press 1106 402
  settle 4

step "keyboard"
  press 1361 764
  settle 18

step "updates and other software, when this build shows it"
  press 1361 764
  settle 18
  when_not_any [[installation, type]]

step "the updates pane is done"
  repeat
    pause 3
    until
      bind done
      source screen
      mode text
      rect [488, 285, 707, 355]
      rect_at [1920, 1080]
      words [[installation, type]]
    max 60

step "the keyboard pane is done"
  repeat
    pause 3
    until
      bind done
      source screen
      mode text
      rect [488, 285, 707, 355]
      rect_at [1920, 1080]
      words [[installation, type], [updates, and, other, software]]
    max 80

step "installation type - install now"
  press 1361 764
  settle 18

step "the disk warning is up"
  repeat
    pause 2
    until
      bind done
      source screen
      mode text
      rect [585, 421, 1073, 580]
      rect_at [1920, 1080]
      words [[write, the, changes, to, disks], [partition, tables]]
    max 60

step "the dialog names the filesystem it will create"
  read
    name format

step "the root partition will be ext4"
  check
    source format
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [ext4]

step "write the changes to disks"
  press 1293 673
  settle 20

step "the disk warning is answered"
  repeat
    pause 3
    until
      bind done
      source screen
      mode text
      rect [487, 285, 702, 355]
      rect_at [1920, 1080]
      words [[where, are, you], [time, zone]]
    max 60

step "where are you"
  press 1361 764
  settle 18

step "the time zone pane is done"
  repeat
    pause 3
    until
      bind done
      source screen
      mode text
      rect [487, 285, 803, 416]
      rect_at [1920, 1080]
      words [[who, are, you], [your, name]]
    max 60

step "who are you - your name"
  press text "{{ user }}"
    at 975 386
  settle 2

step "who are you - username"
  press text "{{ user }}"
    at 859 477
  settle 2

step "who are you - password"
  press text "{{ password }}"
    at 873 514
  settle 2

step "who are you - confirm password"
  press text "{{ password }}"
    at 883 550
  settle 3

step "who are you"
  press 1361 764
  settle 20

step "the install runs, as measured"
  settle 2400

step "stop the machine"
  stop kill
  timeout 120

step "publish the disk"
    save "{{ out }}"
