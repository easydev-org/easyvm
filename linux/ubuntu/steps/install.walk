walkthrough "ubuntu - the subiquity walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [ubuntu.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso ubuntu.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800

  # THE DESKTOP IS DECIDED BY THE REFERENCE IMAGE, for the reason the windows file records: the
  # three brightness thresholds answer "a dark body with a lighter strip", and every installer pane
  # on the way there is close enough to that to be arguable. A reference answers the same question
  # with a measurement two orders of magnitude wider - 0.0043 for a splash against 0.9669 for a
  # desktop on this very recording.

step "wait for the live desktop"
  desktop linux/gnome
  range [0.9, 1]
  rect [0, 0, 1920, 120]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400

  # THE LIVE SESSION'S RIGHT-CLICK MENU IS OPEN MORE OFTEN THAN NOT, because the installer puts it
  # there and the walk's own clicks leave it behind. MEASURED on run 44361392014, where the captured
  # frame had the menu open over the wallpaper and the reference did not: 0.6664 similar.
  #
  # AND THE REFERENCE IS THE INSTALLER'S OWN WINDOW, which is what the next step waits for - so the
  # comparison is about "the live session got this far", not "the desktop is empty".

step "close the right-click menu the live session leaves open"
  input esc
  settle 2


step "settle 2s"
  settle 2

  # THE INSTALLER WINDOW HAS TO BE UP BEFORE THE COMPARISON, NOT AFTER IT.
  #
  # THE ORDER WAS "compare the screen, then wait for the installer", and the two raced. MEASURED
  # ACROSS THREE RUNS: run 44349187441 captured the desktop with the installer's window as a black
  # rectangle (0.6753), run 44361392014 captured it with a right-click menu open (0.6664), and run
  # 44365861355 captured it with "Welcome to Ubuntu / Choose your language" fully drawn (0.6710).
  # Three different screens, because `desktop:` says "brightness, variance and saturation look like
  # a table" and the installer appears somewhere inside that window.
  #
  # SO THE WINDOW IS WAITED FOR FIRST, which makes the screen the comparison sees ONE screen instead
  # of three, and the reference is the frame from a run where it was already up.

step "wait for the installer window"
  repeat
    do
      item
        input 420 300
      item
        settle 5
    until
      bind done
      source screen
      mode text
      rect [873, 208, 1133, 395]
      rect_at [1920, 1080]
      words [[welcome, to, ubuntu], [choose, your, language]]
    max 120


step "settle 3s"
  settle 3


step "the desktop is the one this file was written against"
  read shot


step "the screen is the one this file was written against"
  check
    source shot
    mode like
    must
    name matched
    range [0.97, 1]
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    reference reference/desktop.png


step "welcome / language"
  input 1355 848
  settle 12


step "wait for the accessibility page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[accessibility]]
    max 24


step "accessibility"
  input 1355 848
  settle 12


step "wait for the keyboard layout page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [885, 208, 1036, 271]
      rect_at [1920, 1080]
      words [[keyboard], [layout]]
    max 24


step "keyboard layout"
  input 1355 848
  settle 12


step "wait for the internet connection page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [873, 210, 1046, 268]
      rect_at [1920, 1080]
      words [[internet], [connection]]
    max 24


step "internet connection"
  input 1355 848
  settle 12


step "read whether the installer offered to update itself, which blocks every page behind it"
  read page


step "is the update dialog up"
  check
    source page
    mode text
    name update_offered
    rect [883, 208, 1036, 271]
    rect_at [1920, 1080]
    words [update, available]


step "leave the update page by the same Next every other page uses"
  if update_offered
    then
      item "next, past the update offer"
        input 1355 848
        settle 8


step "wait for the what do you want to do with ubuntu page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [944, 477, 1085, 554]
      rect_at [1920, 1080]
      words [[install], [ubuntu]]
    max 24


step "what do you want to do with ubuntu"
  input 1355 848
  settle 12


step "wait for the type of installation page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [944, 209, 1045, 501]
      rect_at [1920, 1080]
      words [[interactive], [installation]]
    max 24


step "type of installation"
  input 1355 848
  settle 12


step "wait for the applications page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [937, 433, 1027, 496]
      rect_at [1920, 1080]
      words [[apps]]
    max 24


step "applications"
  input 1355 848
  settle 12


step "wait for the optimise your computer page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [1082, 397, 1232, 465]
      rect_at [1920, 1080]
      words [[proprietary]]
    max 24


step "optimise your computer"
  input 1355 848
  settle 12


step "wait for the disk setup page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [944, 473, 1054, 545]
      rect_at [1920, 1080]
      words [[erase], [disk]]
    max 24


step "disk setup"
  input 1355 848
  settle 12


step "wait for the encryption page, because a click that assumes the page before it is a click that can miss"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [852, 210, 967, 271]
      rect_at [1920, 1080]
      words [[encryption]]
    max 24


step "encryption"
  input 1355 848
  settle 12


step "wait for the account page before typing into it"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[create, account]]
    max 24


step "create your account - full name - click the field"
  input 1139 393


step "create your account - full name - select what is there"
  input ctrl+a
  settle 1


step "create your account - full name - delete the selection"
  input backspace
  settle 1


step "create your account - full name - type the value"
  input text "{{ user }}"
  settle 2

step "create your account - username - click the field"
  input 1139 501


step "create your account - username - select what is there"
  input ctrl+a
  settle 1


step "create your account - username - delete the selection"
  input backspace
  settle 1


step "create your account - username - type the value"
  input text "{{ user }}"
  settle 2

step "create your account - password - click the field"
  input 1050 563


step "create your account - password - select what is there"
  input ctrl+a
  settle 1


step "create your account - password - delete the selection"
  input backspace
  settle 1


step "create your account - password - type the value"
  input text "{{ password }}"
  settle 2

step "create your account - confirm password - click the field"
  input 1139 616


step "create your account - confirm password - select what is there"
  input ctrl+a
  settle 1


step "create your account - confirm password - delete the selection"
  input backspace
  settle 1


step "create your account - confirm password - type the value"
  input text "{{ password }}"
  settle 3

step "clear 'require my password to log in'"
  input 923 670
  settle 3


step "create your account"
  input 1355 848
  settle 12


step "wait for the time zone page"
  repeat
    pause 5
    until
      bind there
      source page
      mode text
      rect [944, 210, 1050, 268]
      rect_at [1920, 1080]
      words [[timezone]]
    max 24


step "time zone - new york on the map"
  input 762 483
  settle 4


step "time zone"
  input 1355 848
  settle 14


step "ready to install - the green install button"
  input 1355 848
  settle 30


step "the installer finishes"
  repeat
    do
      item
        input 420 300
        settle 20
    until
      bind done
      source screen
      mode text
      rect [690, 630, 1270, 730]
      rect_at [1920, 1080]
      words [[installed, and, ready, to, use], [restart, to, complete, the, installation], [restart, now]]
    max 270


step "give the installer its last few seconds, because \"ready to use\" is not \"flushed\""
  settle 20


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
