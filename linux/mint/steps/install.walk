walkthrough "mint - the ubiquity walk"
  resolution 1920x1080
  password admin
  var display_name == Vmuser User
  var out == {default: out/distro.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  needs mint.iso, named "the media this stage boots from is already on disk"
  step "create the empty disk"
    disk == disk.qcow2
    disk_gb == 128
  step "boot the installer"
    boot == true
    iso == mint.iso
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 1800
  step "the medium's GRUB menu is up"
    see == name: grub
  step "that menu names mint"
    check == {from: grub, mode: text, name: is_mint, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[start, linux, mint], [linux, mint]]}
  press Return, waiting 20s, named "answer the menu, which does not count down"
  step "wait for the live desktop"
    desktop == linux/cinnamon
    reference == reference/desktop.png
    range == [0.90, 1.0]
    # THE TOP 120 ROWS ARE WALLPAPER AND A MENU BAR: a boot splash scores 0.0002
    # there and every desktop frame 1.0000, including the ones with an installer
    # window over the middle. The clock sits below this band, which is why 120.
    rect == [0, 0, 1920, 120]
    rect_at == [1920, 1080]
    poll == 5
    timeout == 5400
  step "disable the screen saver, its lock and the dpms blank"
    run == gsettings set org.cinnamon.desktop.session idle-delay 0; gsettings set org.cinnamon.desktop.screensaver lock-enabled false; gsettings set org.cinnamon.desktop.screensaver idle-activation-enabled false; xrandr --output Virtual-1 --mode 1920x1080 2>/dev/null || xrandr --output Virtual1 --mode 1920x1080 2>/dev/null || xrandr -s 1920x1080 2>/dev/null || true; xset s off; xset -dpms; xset s noblank; ( for i in $(seq 1 1080); do xdotool mousemove_relative -- 1 0 2>/dev/null; xdotool mousemove_relative -- -1 0 2>/dev/null; sleep 20; done ) >/dev/null 2>&1 & exit
    settle == 10
    terminal_wait == 8
    type_gap == 0.15
  step "the desktop's install icon is on screen"
    see == name: desktop
  step "that icon names the installer"
    check == {from: desktop, mode: text, name: launcher, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[Install]]}
  click "select the installer's icon" at 114 52, waiting 3s, named "select the installer's icon"
  press Return, waiting 25s, named "open it with the keyboard, because a double-click does not"
  step "the installer window is up"
    loop == {check: {from: installer, mode: text, name: up, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[Welcome], [Keyboard], [Multimedia]]}, do: [{settle: 6}], max: 30, see: {name: installer}, until: {fact: up}}
  click welcome at 1306 727, waiting 12s, named "welcome"
  click keyboard at 1306 727, waiting 12s, named "keyboard"
  click multimedia at 1306 727, waiting 12s, named "multimedia codecs"
  click installation at 1306 727, waiting 15s, named "installation type"
  step "the dialog names the filesystem it will create"
    see == name: format
  step "the root partition will be ext4"
    check == {from: format, mode: text, name: ext4, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[ext4]]}
  click "write the changes to disks" at 1266 663, waiting 25s, named "write the changes to disks"
  click "installation type - install now, after the modal" at 1307 726, waiting 30s, named "installation type - install now, after the modal"
  click "where are you" at 1306 727, waiting 15s, named "where are you"
  step "who are you - full name"
    click == [965, 347]
    settle == 2
    type == '{{ display_name }}'
  step "who are you - password"
    click == [877, 458]
    settle == 2
    type == '{{ password }}'
  step "who are you - confirm password"
    click == [877, 492]
    settle == 3
    type == '{{ password }}'
  click "who are you" at 1306 727, waiting 20s, named "who are you"
  step "the install finishes"
    loop == {check: {from: finished, mode: text, name: done, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], scale: 1, words: [[restart]]}, do: [{settle: 15}], max: 120, see: {name: finished}, until: {fact: done}}
  step "stop the machine"
    shutdown == kill
    timeout == 120
  step "publish the disk"
    compress == '{{ out }}'
