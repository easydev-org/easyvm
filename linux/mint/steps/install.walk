walkthrough "mint - the ubiquity walk"
resolution 1920x1080
recording_resolution 1920x1080
var display_name "Vmuser User"
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [mint.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso mint.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "the medium's GRUB menu is up"
  read
    name grub


step "that menu names mint"
  check
    source grub
    mode text
    name is_mint
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[start, linux, mint], [linux, mint]]

  # THE MENU TAKES THE KEY AND THEN SITS THERE, SO THE KEY IS SENT MORE THAN ONCE.
  #
  # MEASURED ON RUN 44471061649, whose recording is the SAME FRAME from 20 seconds to the end -
  # 2979 seconds of "Press enter to boot the selected OS" with the highlight still on the first
  # entry. One Return, twenty seconds, and nothing moved: unlike every later step in this file,
  # which is a click the guest has to answer, this one is a keystroke into a firmware menu that may
  # not have finished drawing when `see:` captured it.
  #
  # THREE, FIVE SECONDS APART, is what the file already does elsewhere for a screen that appears more
  # than once - and a second Return on a menu that has already gone is harmless, because the live
  # session ignores it.

step "answer the menu, which does not count down"
  input ret
  settle 5


step "answer it again, because a firmware menu can miss the first key"
  input ret
  settle 5


step "and once more, then let the kernel start"
  input ret
  settle 20


step "wait for the live desktop"
  desktop linux/cinnamon
  poll 5
  range [0.9, 1]
  # THE REFERENCE WAS A DESKTOP WITH A TERMINAL WINDOW ON IT, AND THE GATE RUNS BEFORE THAT
  # TERMINAL IS OPENED. MEASURED ON RUN 44477977288, which spent its whole 1h30m reading 0.0126
  # and then 0.0166 against a desktop that was plainly up: the reference held a `gnome-terminal`
  # running the gsettings commands, and `wait for the live desktop` is FOUR STEPS EARLIER than the
  # step that opens it. No band could have matched both, which is why the top 120 rows were not
  # the whole story.
  #
  # THE REFERENCE IS NOW THIS MEDIUM'S OWN DESKTOP at 400 s, before the terminal.
  #
  # THE BAND IS TOP-RIGHT WALLPAPER, x 1500..1900 and y 150..350: clear of the installer icon at
  # the top left, of the logo in the middle, and of the Cinnamon panel at the bottom.
  # MEASURED on that recording: boot and splash frames 0.0000, and every desktop frame 1.0000.
  #
  # THE SCREENSAVER IS WHY THE WINDOW MATTERS. This guest dims its whole display to 0.29 of its
  # brightness at about 960 s - every pixel, uniformly - so a gate that is still waiting then
  # cannot match ANY reference. The desktop is up at 45 s and the dimming is 15 minutes later, and
  # `poll: 5` means the gate has 180 chances in between.
  rect [1500, 150, 1900, 350]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "disable the screen saver, its lock and the dpms blank"
  run "gsettings set org.cinnamon.desktop.session idle-delay 0; gsettings set org.cinnamon.desktop.screensaver lock-enabled false; gsettings set org.cinnamon.desktop.screensaver idle-activation-enabled false; xrandr --output Virtual-1 --mode 1920x1080 2>/dev/null || xrandr --output Virtual1 --mode 1920x1080 2>/dev/null || xrandr -s 1920x1080 2>/dev/null || true; xset s off; xset -dpms; xset s noblank; ( for i in $(seq 1 1080); do xdotool mousemove_relative -- 1 0 2>/dev/null; xdotool mousemove_relative -- -1 0 2>/dev/null; sleep 20; done ) >/dev/null 2>&1 & exit"
  settle 10
  terminal_wait 8
  type_gap 0.15


step "the desktop's install icon is on screen"
  read
    name desktop


step "that icon names the installer"
  check
    source desktop
    mode text
    name launcher
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[Install]]


step "select the installer's icon"
  input 114 52
  settle 3


step "open it with the keyboard, because a double-click does not"
  input ret
  settle 25


step "the installer window is up"
  repeat
    pause 6
    until
      bind up
      source installer
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[Welcome], [Keyboard], [Multimedia]]
    max 30


step "welcome"
  input 1306 727
  settle 12


step "keyboard"
  input 1306 727
  settle 12


step "multimedia codecs"
  input 1306 727
  settle 12


step "installation type"
  input 1306 727
  settle 15


step "the dialog names the filesystem it will create"
  read
    name format


step "the root partition will be ext4"
  check
    source format
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[ext4]]


step "write the changes to disks"
  input 1266 663
  settle 25


step "installation type - install now, after the modal"
  input 1307 726
  settle 30


step "where are you"
  input 1306 727
  settle 15


step "who are you - full name"
  input text "{{ display_name }}"
    at 965 347
  settle 2


step "who are you - password"
  input text "{{ password }}"
    at 877 458
  settle 2


step "who are you - confirm password"
  input text "{{ password }}"
    at 877 492
  settle 3


step "who are you"
  input 1306 727
  settle 20


step "the install finishes"
  repeat
    pause 15
    until
      bind done
      source finished
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[restart]]
    max 120


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
