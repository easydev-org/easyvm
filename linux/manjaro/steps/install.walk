walkthrough "manjaro - the Calamares walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [manjaro.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso manjaro.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  desktop linux/kde
  range [0.9, 1]
  # THE TOP 120 ROWS ARE WALLPAPER AND A MENU BAR: a boot splash scores 0.0002
  # there and every desktop frame 1.0000, including the ones with an installer
  # window over the middle. The clock sits below this band, which is why 120.
  rect [0, 0, 1920, 120]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "let the desktop settle"
  settle 15


step "open the installer"
  input 960 760
    double [960, 760]
  settle 35


step "open the installer - what is on screen"
  read
    name open_the_installer


step "open the installer - the screen says so"
  check
    source open_the_installer
    mode text
    name asserted
    rect [438, 296, 963, 385]
    rect_at [1920, 1080]
    words [[welcome], [location]]


step "open the installer (once more, if it did not)"
  input 960 760
    double [960, 760]
  settle 40
  when_not [welcome]


step "welcome"
  input 1325 801
  settle 18


step "location"
  input 1325 801
  settle 18


step "keyboard"
  input 1325 801
  settle 18


step "partitions - erase the disk"
  input 653 340
  settle 6


step "open the filesystem list"
  input 955 396
  settle 5


step "choose ext4"
  input 933 459
  settle 6


step "the partitions page after choosing ext4"
  read
    name fs


step "the root partition is ext4"
  check
    source fs
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [ext4]


step "partitions"
  input 1325 801
  settle 20


step "users - full name"
  input text "{{ user }}"
    at 741 320
  settle 2


step "users - login name"
  input text "{{ user }}"
    at 741 385
  settle 2


step "users - password"
  input text "{{ password }}"
    at 724 523
  settle 2


step "users - confirm password"
  input text "{{ password }}"
    at 944 523
  settle 2


step "users - root password"
  input text "{{ password }}"
    at 741 650
  settle 2


step "users - confirm root password"
  input text "{{ password }}"
    at 944 650
  settle 3


step "users"
  input 1325 801
  settle 20


step "office suite - no office suite"
  input 700 288
  settle 6


step "office suite"
  input 1334 794
  settle 20


step "summary - install"
  input 1318 799
  settle 18


step "the install confirmation's install now"
  input 1055 537
  settle 30


step "the installer finishes"
  repeat
    do
      item
        input 420 300
        settle 20
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[all, done], [you, may, now], [has, been, installed], [todo, listo], [ya, puede], [reiniciar], [instalación, completada], [instalacion, completada]]
    max 180


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
