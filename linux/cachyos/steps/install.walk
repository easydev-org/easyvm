walkthrough "cachyos - install to ext4, then the power button"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/cachyos.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [cachyos.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso cachyos.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  desktop linux/kde
  poll 5
  range [0.9, 1]
  # THE TOP 120 ROWS ARE WALLPAPER AND A MENU BAR: a boot splash scores 0.0002
  # there and every desktop frame 1.0000, including the ones with an installer
  # window over the middle. The clock sits below this band, which is why 120.
  rect [0, 0, 1920, 120]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "let the desktop settle"
  settle 15


step "open the installer"
  input 960 743
  settle 1


step "open the installer, second click"
  input 960 743
  settle 25


step "the installer is on screen"
  repeat
    pause 5
    until
      bind up
      source cal
      mode text
      rect [792, 301, 1032, 774]
      rect_at [1920, 1080]
      scale 1
      words [[welcome, installer], [欢迎], [cachyos, 安装]]
    max 40


step "choose English, retrying until the page says so"
  repeat
    do
      item
        input 980 661
        settle 4
      item
        input e
        settle 2
      item
        input up
        settle 1
      item
        input up
        settle 1
      item
        input ret
        settle 6
    until
      bind ok
      source english
      mode text
      rect [718, 369, 991, 428]
      rect_at [1920, 1080]
      scale 1
      words [[program], [questions]]
    max 6


step "next from welcome"
  input 1356 751
  settle 8


step "the location page arrives after welcome"
  repeat
    pause 10
    until
      bind here
      source at_location
      mode text
      rect [399, 639, 1036, 699]
      rect_at [1920, 1080]
      scale 1
      words [[Region], [zone]]
    max 30


step "next from location"
  input 1356 791
  settle 8


step "the keyboard page arrives after location"
  repeat
    pause 10
    until
      bind here
      source at_keyboard
      mode text
      rect [393, 511, 497, 572]
      rect_at [1920, 1080]
      scale 1
      words [[Keyboard], [Layout]]
    max 30


step "next from keyboard"
  input 1360 792
  settle 8


step "the bootloader page arrives after keyboard"
  repeat
    pause 10
    until
      bind here
      source at_bootloader
      mode text
      rect [797, 713, 1456, 774]
      rect_at [1920, 1080]
      scale 1
      words [[snapshot], [chainloading]]
    max 30


step "the bootloader page"
  read
    name boot


step "choose grub"
  input 500 305
  settle 5


step "grub is selected"
  read
    name grub


step "the bootloader is grub"
  check
    source grub
    mode text
    name ok
    rect [401, 285, 483, 342]
    rect_at [1920, 1080]
    scale 1
    words [[grub]]


step "next from bootloader"
  input 1356 791
  settle 10


step "the partitions page arrives after the bootloader"
  repeat
    pause 10
    until
      bind here
      source at_partitions
      mode text
      rect [483, 288, 606, 450]
      rect_at [1920, 1080]
      scale 1
      words [[storage], [Erase], [Manual]]
    max 30


step "select erase disk"
  input 427 366
  settle 8


step "the partitions page with erase selected"
  read
    name parts


step "open the filesystem list"
  input 543 425
  settle 5


step "choose ext4"
  input 527 517
  settle 6


step "the partitions page settles after the filesystem list closes"
  repeat
    pause 10
    until
      bind here
      source at_partitions_again
      mode text
      rect [483, 288, 606, 450]
      rect_at [1920, 1080]
      scale 1
      words [[storage], [Erase], [Manual]]
    max 24


step "the page after choosing ext4"
  read
    name fs


step "the root partition is ext4"
  check
    source fs
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[ext4]]


step "next from partitions"
  input 1356 793
  settle 10


step "the desktop page"
  read
    name desk


step "next from desktop"
  input 1356 793
  settle 12


step "the packages page"
  read
    name pkgs


step "next from packages"
  input 1356 793
  settle 12


step "the users page arrives before anything is typed into it"
  repeat
    pause 10
    until
      bind here
      source at_users
      mode text
      rect [401, 453, 696, 579]
      rect_at [1920, 1080]
      scale 1
      words [[Computer], [Repeat], [Password]]
    max 30


step "the users page"
  read
    name users


step "the full name"
  input text "{{ user }}"
    at 515 341
  settle 3


step "the login name - click the field"
  input 515 412


step "the login name - select what is there"
  input ctrl+a
  settle 1


step "the login name - delete the selection"
  input backspace
  settle 1


step "the login name - type the value"
  input text "{{ user }}"
  settle 3

step "the password"
  input text "{{ password }}"
    at 515 550
  settle 2


step "the password again"
  input text "{{ password }}"
    at 720 552
  settle 3


step "the users page is filled in"
  read
    name filled


step "the password was accepted"
  check
    source filled
    mode text
    name ok
    rect [396, 306, 494, 452]
    rect_at [1920, 1080]
    scale 1
    without [match]
    words [vmuser]


step "next from users"
  input 1356 793
  settle 10


step "the summary page arrives before install is clicked"
  repeat
    pause 10
    until
      bind here
      source at_summary
      mode text
      rect [452, 279, 676, 340]
      rect_at [1920, 1080]
      scale 1
      words [[overview], [happen]]
    max 30


step "the summary page"
  read
    name summary


step "the summary names ext4"
  check
    source summary
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    scale 1
    words [[ext4]]


step "start the install"
  input 1362 872
  settle 10


step "the confirmation dialog"
  read
    name confirm


step "install now"
  input 1055 617
  settle 25


step "the install writes the disk"
  disk_min_mb 4000
  disk_settle 300
  poll 20
  timeout 3600


step "the install is done"
  repeat
    pause 15
    until
      bind finished
      source done
      mode text
      rect [912, 549, 1009, 607]
      rect_at [1920, 1080]
      scale 1
      words [[installed]]
    max 80


step "stop the machine"
  stop kill
  timeout 600


step "publish the disk"
    save "{{ out }}"
