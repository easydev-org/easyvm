walkthrough "linux-kubuntu - sshd"
  resolution 1920x1080
  password admin
  var out == {default: out/distro.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  step "boot the disk"
    boot == true
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 900
  step "the session is up, which is what autologin is for"
    loop == {check: {from: desk, mode: text, name: up, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [[applications], [welcome], [kubuntu]]}, do: [{settle: 10}], max: 40, see: {name: desk}, until: {fact: up}}
  press ctrl+alt+t, waiting 20s, named "open the terminal"
  step "install openssh-server"
    run == echo {{ password }} | sudo -S sh -c "export DEBIAN_FRONTEND=noninteractive; apt-get update -o DPkg::Lock::Timeout=600 && apt-get install -y -o DPkg::Lock::Timeout=600 openssh-server" 2>&1 | tail -6
    settle == 90
    terminal_wait == 0
  step "allow password authentication"
    run == echo {{ password }} | sudo -S -p '' sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf "PasswordAuthentication yes\n" > /etc/ssh/sshd_config.d/99-vm.conf; sed -i "s/^#\?\s*PasswordAuthentication.*/PasswordAuthentication yes/" /etc/ssh/sshd_config; grep -q "^PasswordAuthentication yes" /etc/ssh/sshd_config || printf "PasswordAuthentication yes\n" >> /etc/ssh/sshd_config' 2>&1 | tail -3
    settle == 3
    terminal_wait == 0
  step "enable ssh at boot"
    run == echo {{ password }} | sudo -S systemctl enable ssh 2>&1 | tail -3
    settle == 8
    terminal_wait == 0
  step "prove the setting took"
    run == echo {{ password }} | sudo -S sh -c 'sshd -T 2>/dev/null | grep -i "^passwordauthentication" || echo PASSWORDAUTH-UNREADABLE' 2>&1 | tail -3
    settle == 3
    terminal_wait == 0
  step "start ssh"
    run == echo {{ password }} | sudo -S systemctl restart ssh 2>&1 | tail -3
    settle == 10
    terminal_wait == 0
  step "prove ssh is active"
    run == systemctl is-active ssh
    settle == 5
    terminal_wait == 0
  step "wait for sshd"
    require_ssh == true
    timeout == 600
  step "prove the kernel over ssh"
    ssh == uname -a
    timeout == 120
  step "prove the account over ssh"
    ssh == id -un; hostname
    timeout == 120
  step "ask the guest to power off"
    ssh == printf '%s\n' '{{ password }}' | sudo -S -p '' poweroff
    timeout == 300
  step "wait for the machine to stop"
    timeout == 300
    wait_until == stopped
  step "publish the disk"
    compress == '{{ out }}'
