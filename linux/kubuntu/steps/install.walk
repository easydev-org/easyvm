walkthrough "kubuntu 26.04 - install to ext4, then the power button"
  resolution 1920x1080
  password admin
  var out == {default: out/kubuntu.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  needs kubuntu.iso, named "the media this stage boots from is already on disk"
  step "create the empty disk"
    disk == disk.qcow2
    disk_gb == 128
  step "boot the installer"
    boot == true
    iso == kubuntu.iso
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 1800
  step "wait for the installer's launcher"
    desktop == linux/kubuntu
    timeout == 5400
  click "open the installer" at 1332 844, waiting 20s, named "open the installer"
  step "calamares is open"
    see == name: cal
  step "the installer's first page"
    check == {from: cal, mode: text, name: opened, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [welcome, partitions, next]}
  click "next from welcome" at 1777 1059, waiting 8s, named "next from welcome"
  click "next from location" at 1777 1059, waiting 8s, named "next from location"
  click "next from keyboard" at 1777 1059, waiting 8s, named "next from keyboard"
  step "the installation mode page"
    see == name: mode
  click "next from customize" at 1777 1059, waiting 8s, named "next from customize"
  step "the partitions page"
    see == name: parts
  click "select erase disk" at 250 76, waiting 6s, named "select erase disk"
  step "the erase page shows ext4"
    see == name: fs
  step "the default filesystem is ext4"
    check == {from: fs, mode: text, name: ext4, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [ext4]}
  click "next from partitions" at 1777 1059, waiting 8s, named "next from partitions"
  step "the users page"
    see == name: users
  step "the full name"
    click == [293, 51]
    settle == 2
    type == '{{ user }}'
  step "the login name"
    clear == true
    click == [293, 119]
    settle == 2
    type == '{{ user }}'
  step "the computer name"
    clear == true
    click == [293, 187]
    settle == 2
    type == kubuntu
  step "the password"
    clear == true
    click == [293, 255]
    settle == 2
    type == '{{ password }}'
  step "the password again"
    clear == true
    click == [500, 255]
    settle == 2
    type == '{{ password }}'
  click "log in automatically" at 205 295, waiting 3s, named "log in automatically"
  step "the users page is filled in"
    see == name: filled
  step "the password was accepted"
    check == {from: filled, mode: text, name: ok, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], without: [short], words: [vmuser]}
  click "next from users" at 1777 1059, waiting 8s, named "next from users"
  step "the summary page"
    see == name: summary
  step "the summary names ext4"
    check == {from: summary, mode: text, name: ext4, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [ext4]}
  click "start the install" at 1777 1059, waiting 8s, named "start the install"
  step "the confirmation dialog"
    see == name: confirm
  click install at 1071 535, waiting 15s, named "install now"
  step "the install writes the disk"
    disk_min_mb == 4000
    disk_settle == 300
    timeout == 3600
  step "the install is done"
    loop == {check: {from: done, mode: text, name: finished, rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], words: [installed]}, do: [{settle: 15}], max: 60, see: {name: done}, until: {fact: finished}}
  step "stop the machine"
    shutdown == kill
    timeout == 600
  step "publish the disk"
    compress == '{{ out }}'
