walkthrough "kubuntu 26.04 - install to ext4, then the power button"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/kubuntu.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [kubuntu.iso]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the installer"
  boot
  iso kubuntu.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800

step "wait for the installer's launcher"
  desktop linux/kubuntu
  timeout 5400

step "open the installer"
  press 1332 844
  settle 20

step "calamares is open"
  read
    name cal

step "the installer's first page"
  check
    source cal
    mode text
    name opened
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [welcome, partitions, next]

step "next from welcome"
  press 1777 1059
  settle 8

step "next from location"
  press 1777 1059
  settle 8

step "next from keyboard"
  press 1777 1059
  settle 8

step "the installation mode page"
  read
    name mode

step "next from customize"
  press 1777 1059
  settle 8

step "the partitions page"
  read
    name parts

step "select erase disk"
  press 250 76
  settle 6

step "the erase page shows ext4"
  read
    name fs

step "the default filesystem is ext4"
  check
    source fs
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [ext4]

step "next from partitions"
  press 1777 1059
  settle 8

step "the users page"
  read
    name users

step "the full name"
  press text "{{ user }}"
    at 293 51
  settle 2

step "the login name"
  clear
  press text "{{ user }}"
    at 293 119
  settle 2

step "the computer name"
  clear
  press text kubuntu
    at 293 187
  settle 2

step "the password"
  clear
  press text "{{ password }}"
    at 293 255
  settle 2

step "the password again"
  clear
  press text "{{ password }}"
    at 500 255
  settle 2

step "log in automatically"
  press 205 295
  settle 3

step "the users page is filled in"
  read
    name filled

step "the password was accepted"
  check
    source filled
    mode text
    name ok
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    without [short]
    words [vmuser]

step "next from users"
  press 1777 1059
  settle 8

step "the summary page"
  read
    name summary

step "the summary names ext4"
  check
    source summary
    mode text
    name ext4
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]
    words [ext4]

step "start the install"
  press 1777 1059
  settle 8

step "the confirmation dialog"
  read
    name confirm

step "install now"
  press 1071 535
  settle 15

step "the install writes the disk"
  disk_min_mb 4000
  disk_settle 300
  timeout 3600

step "the install is done"
  repeat
    pause 15
    until
      bind finished
      source done
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [installed]
    max 60

step "stop the machine"
  stop kill
  timeout 600

step "publish the disk"
    save "{{ out }}"
