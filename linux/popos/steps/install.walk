walkthrough "popos - the pop installer walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [popos.iso]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the installer"
  boot
  iso popos.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800

step "wait for the live desktop"
  desktop linux/gnome
  poll 5
  range [0.9, 1]
  # THE TOP 120 ROWS ARE NOT GOOD ENOUGH ON THIS MEDIUM, AND THAT IS MEASURED RATHER THAN SUSPECTED.
  #
  # Scored against this medium's own recording, the top band gives a WORST desktop frame of
  # 0.8115 - under the 0.90 the gate asks for. Its menu bar carries a clock and a set of status
  # icons that move, and unlike ubuntu's (0.9816 worst) there is enough of them to lose the gate.
  # A reference band that depends on a clock is a band that fails whenever the minute differs.
  #
  # THE LEFT 300 PIXELS, rows 280..480, are wall paper in every desktop frame: 0.9990 minimum
  # across 63 samples. The installer window does not reach this far left, so the gate does not
  # depend on where the installer happens to be. Boot and splash frames score 0.0000 there.
  rect [0, 280, 300, 480]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400

step "open the installer from the dock"
  press 1211 1050
  settle 20

step "the installer window is up"
  repeat
    do
      item
        press 420 300
        settle 3
    until
      bind done
      from screen
      mode text
      rect [698, 153, 945, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Install], [Language], [Clean], [Erase], [Account]]
    max 100

step "select the language, all the way to the keyboard page"
  repeat
    do
      item
        press 1367 810
        settle 6
    until
      bind there
      from kb
      mode text
      rect [728, 680, 857, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Layout]]
    max 8

step "the keyboard page is up"
  repeat
    pause 3
    until
      bind there
      from kb
      mode text
      rect [728, 680, 857, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Layout], [Type]]
    max 20

step "the keyboard layout, which is US"
  press 1190 696
  settle 3

step "the layout types latin letters"
  repeat
    do
      item
        clear
        press text abc
          at 1190 757
        settle 1
        type_gap 0.12
    until
      bind latin
      from layout_test
      mode matches
      pattern "^[a-z]{2,5}$"
      rect [968, 743, 1351, 770]
      rect_at [1920, 1080]
      scale 6
    max 4

step "take the keyboard layout"
  press 1367 810
  settle 6

step "the install page is up"
  repeat
    pause 3
    until
      bind there
      from inst
      mode text
      rect [1012, 391, 1105, 548]
      rect_at [1920, 1080]
      scale 1
      words [[Clean], [Custom]]
    max 20

step "clean install"
  press 1000 433
  settle 3

step "install"
  press 1367 810
  settle 6

step "the drive page is up"
  repeat
    pause 3
    until
      bind there
      from drv
      mode text
      rect [726, 458, 1217, 748]
      rect_at [1920, 1080]
      scale 1
      words [[drive], [Virtio]]
    max 20

step "select a drive"
  press 1185 497
  settle 4

step "erase and install"
  press 1367 810
  settle 10

step "wait for the account pane"
  repeat
    pause 2
    until
      bind done
      from screen
      mode text
      rect [731, 533, 1021, 790]
      rect_at [1920, 1080]
      scale 1
      words [[Account], [User]]
    max 45

step "type the display name"
  repeat
    do
      item
        clear
        press text "VM User"
          at 1190 530
        settle 2
        type_gap 0.09
    until
      bind took
      from name_box
      mode text
      rect [968, 518, 1411, 541]
      rect_at [1920, 1080]
      scale 6
      words [[VM], [User]]
    max 4

step "create user account, and wait for the password pane"
  repeat
    do
      item
        press 1367 816
        settle 8
    until
      bind there
      from pw_pane
      mode text
      rect [943, 383, 1161, 544]
      rect_at [1920, 1080]
      scale 3
      words [[Confirm], [Password]]
    max 6

step "type the password"
  clear
  press text "{{ password }}"
    at 1200 448
  settle 2
  type_gap 0.09

step "confirm the password"
  clear
  press text "{{ password }}"
    at 1200 544
  settle 2
  type_gap 0.09

step "account password next"
  press 1367 810
  settle 25

step "drive encryption - don't encrypt"
  press 1367 810
  settle 15

step "the install has started"
  repeat
    pause 6
    until
      bind begun
      from started
      mode text
      rect [491, 722, 598, 784]
      rect_at [1920, 1080]
      scale 3
      words [[Extracting], [Installing], [Copying]]
    max 20
  settle 35

step "the install is written"
  disk_min_mb 512
  disk_settle 180
  poll 20
  timeout 3600

step "stop the machine"
  stop kill
  timeout 120

step "publish the disk"
    save "{{ out }}"
