walkthrough "popos - the pop installer walk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [popos.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso popos.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  repeat
    do
      item
        read
          name screen
    until
      check
        source screen
        mode like
        reference reference/desktop.png
        range [0.9, 1]
        rect [0, 280, 300, 480]
        rect_at [1920, 1080]
        must true
    max 1080
    pause 5


step "open the installer from the dock"
  input 1211 1050
  settle 20


step "the installer window is up"
  repeat
    do
      item
        input 420 300
        settle 3
    until
      bind done
      source screen
      mode text
      rect [698, 153, 945, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Install], [Language], [Clean], [Erase], [Account]]
    max 100


step "select the language, all the way to the keyboard page"
  repeat
    do
      item
        input 1367 810
        settle 6
    until
      bind there
      source kb
      mode text
      rect [728, 680, 857, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Layout]]
    max 8


step "the keyboard page is up"
  repeat
    pause 3
    until
      bind there
      source kb
      mode text
      rect [728, 680, 857, 755]
      rect_at [1920, 1080]
      scale 1
      words [[Layout], [Type]]
    max 20


step "the keyboard layout, which is US"
  input 1190 696
  settle 3


step "the layout types latin letters - click the field"
  input 1190 757


step "the layout types latin letters - select what is there"
  input ctrl+a
  settle 1


step "the layout types latin letters - delete the selection"
  input backspace
  settle 1


step "the layout types latin letters - type the value"
  input text abc


step "the layout types latin letters - the field took it"
  repeat
    do
      item
        type_gap 0.12
    until
      bind latin
      source layout_test
      mode matches
      pattern "^[a-z]{2,5}$"
      rect [968, 743, 1351, 770]
      rect_at [1920, 1080]
      scale 6
    max 4
  settle 1

step "take the keyboard layout"
  input 1367 810
  settle 6


step "the install page is up"
  repeat
    pause 3
    until
      bind there
      source inst
      mode text
      rect [1012, 391, 1105, 548]
      rect_at [1920, 1080]
      scale 1
      words [[Clean], [Custom]]
    max 20


step "clean install"
  input 1000 433
  settle 3


step "install"
  input 1367 810
  settle 6


step "the drive page is up"
  repeat
    pause 3
    until
      bind there
      source drv
      mode text
      rect [726, 458, 1217, 748]
      rect_at [1920, 1080]
      scale 1
      words [[drive], [Virtio]]
    max 20


step "select a drive"
  input 1185 497
  settle 4


step "erase and install"
  input 1367 810
  settle 10


step "wait for the account pane"
  repeat
    pause 2
    until
      bind done
      source screen
      mode text
      rect [731, 533, 1021, 790]
      rect_at [1920, 1080]
      scale 1
      words [[Account], [User]]
    max 45


step "type the display name - click the field"
  input 1190 530


step "type the display name - select what is there"
  input ctrl+a
  settle 1


step "type the display name - delete the selection"
  input backspace
  settle 1


step "type the display name - type the value"
  input text "VM User"


step "type the display name - the field took it"
  repeat
    do
      item
        type_gap 0.09
    until
      bind took
      source name_box
      mode text
      rect [968, 518, 1411, 541]
      rect_at [1920, 1080]
      scale 6
      words [[VM], [User]]
    max 4
  settle 2

step "create user account, and wait for the password pane"
  repeat
    do
      item
        input 1367 816
        settle 8
    until
      bind there
      source pw_pane
      mode text
      rect [943, 383, 1161, 544]
      rect_at [1920, 1080]
      scale 3
      words [[Confirm], [Password]]
    max 6


step "type the password - click the field"
  input 1200 448


step "type the password - select what is there"
  input ctrl+a
  settle 1


step "type the password - delete the selection"
  input backspace
  settle 1


step "type the password - type the value"
  input text "{{ password }}"
  type_gap 0.09
  settle 2

step "confirm the password - click the field"
  input 1200 544


step "confirm the password - select what is there"
  input ctrl+a
  settle 1


step "confirm the password - delete the selection"
  input backspace
  settle 1


step "confirm the password - type the value"
  input text "{{ password }}"
  type_gap 0.09
  settle 2

step "account password next"
  input 1367 810
  settle 25


step "drive encryption - don't encrypt"
  input 1367 810
  settle 15


step "the install has started"
  repeat
    pause 6
    until
      bind begun
      source started
      mode text
      rect [491, 722, 598, 784]
      rect_at [1920, 1080]
      scale 3
      words [[Extracting], [Installing], [Copying]]
    max 20
  settle 35


step "the install is written"
  disk_min_mb 512
  disk_settle 180
  poll 20
  timeout 3600


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
