walkthrough "popos - the pop installer walk"
  resolution 1920x1080
  password admin
  var out == {default: out/distro.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header recording_resolution == [1920, 1080]

  needs popos.iso, named "the media this stage boots from is already on disk"
  step "create the empty disk"
    disk == disk.qcow2
    disk_gb == 128
  step "boot the installer"
    boot == true
    iso == popos.iso
    os == linux
    # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
    memory_mb == 4096
    timeout == 1800
  step "wait for the live desktop"
    desktop == linux/gnome
    reference == reference/desktop.png
    range == [0.90, 1.0]
    # THE TOP 120 ROWS ARE NOT GOOD ENOUGH ON THIS MEDIUM, AND THAT IS MEASURED RATHER THAN SUSPECTED.
    #
    # Scored against this medium's own recording, the top band gives a WORST desktop frame of
    # 0.8115 - under the 0.90 the gate asks for. Its menu bar carries a clock and a set of status
    # icons that move, and unlike ubuntu's (0.9816 worst) there is enough of them to lose the gate.
    # A reference band that depends on a clock is a band that fails whenever the minute differs.
    #
    # THE LEFT 300 PIXELS, rows 280..480, are wall paper in every desktop frame: 0.9990 minimum
    # across 63 samples. The installer window does not reach this far left, so the gate does not
    # depend on where the installer happens to be. Boot and splash frames score 0.0000 there.
    rect == [0, 280, 300, 480]
    rect_at == [1920, 1080]
    poll == 5
    timeout == 5400
  click "open the installer from the dock" at 1211 1050, waiting 20s, named "open the installer from the dock"
  step "the installer window is up"
    loop == {check: {from: screen, mode: text, name: done, rect: [698, 153, 945, 755], rect_at: [1920, 1080], scale: 1, words: [[Install], [Language], [Clean], [Erase], [Account]]}, do: [{click: [420, 300], settle: 3}], max: 100, see: {name: screen}, until: {fact: done}}
  step "select the language, all the way to the keyboard page"
    loop == {check: {from: kb, mode: text, name: there, rect: [728, 680, 857, 755], rect_at: [1920, 1080], scale: 1, words: [[Layout]]}, do: [{click: [1367, 810], settle: 6}], max: 8, see: {name: kb}, until: {fact: there}}
  step "the keyboard page is up"
    loop == {check: {from: kb, mode: text, name: there, rect: [728, 680, 857, 755], rect_at: [1920, 1080], scale: 1, words: [[Layout], [Type]]}, do: [{settle: 3}], max: 20, see: {name: kb}, until: {fact: there}}
  click "the keyboard layout, which is US" at 1190 696, waiting 3s, named "the keyboard layout, which is US"
  step "the layout types latin letters"
    loop == {check: {from: layout_test, mode: matches, name: latin, pattern: "^[a-z]{2,5}$", rect: [968, 743, 1351, 770], rect_at: [1920, 1080], scale: 6}, do: [{clear: true, click: [1190, 757], settle: 1, type: abc, type_gap: 0.12}], max: 4, see: {name: layout_test}, until: {fact: latin}}
  click "take the keyboard layout" at 1367 810, waiting 6s, named "take the keyboard layout"
  step "the install page is up"
    loop == {check: {from: inst, mode: text, name: there, rect: [1012, 391, 1105, 548], rect_at: [1920, 1080], scale: 1, words: [[Clean], [Custom]]}, do: [{settle: 3}], max: 20, see: {name: inst}, until: {fact: there}}
  click clean at 1000 433, waiting 3s, named "clean install"
  click install at 1367 810, waiting 6s, named "install"
  step "the drive page is up"
    loop == {check: {from: drv, mode: text, name: there, rect: [726, 458, 1217, 748], rect_at: [1920, 1080], scale: 1, words: [[drive], [Virtio]]}, do: [{settle: 3}], max: 20, see: {name: drv}, until: {fact: there}}
  click "select a drive" at 1185 497, waiting 4s, named "select a drive"
  click "erase and install" at 1367 810, waiting 10s, named "erase and install"
  step "wait for the account pane"
    loop == {check: {from: screen, mode: text, name: done, rect: [731, 533, 1021, 790], rect_at: [1920, 1080], scale: 1, words: [[Account], [User]]}, do: [{settle: 2}], max: 45, see: {name: screen}, until: {fact: done}}
  step "type the display name"
    loop == {check: {from: name_box, mode: text, name: took, rect: [968, 518, 1411, 541], rect_at: [1920, 1080], scale: 6, words: [[VM], [User]]}, do: [{clear: true, click: [1190, 530], settle: 2, type: "VM User", type_gap: 0.09}], max: 4, see: {name: name_box}, until: {fact: took}}
  step "create user account, and wait for the password pane"
    loop == {check: {from: pw_pane, mode: text, name: there, rect: [943, 383, 1161, 544], rect_at: [1920, 1080], scale: 3, words: [[Confirm], [Password]]}, do: [{click: [1367, 816], settle: 8}], max: 6, see: {name: pw_pane}, until: {fact: there}}
  step "type the password"
    clear == true
    click == [1200, 448]
    settle == 2
    type == '{{ password }}'
    type_gap == 0.09
  step "confirm the password"
    clear == true
    click == [1200, 544]
    settle == 2
    type == '{{ password }}'
    type_gap == 0.09
  click "account password next" at 1367 810, waiting 25s, named "account password next"
  click "drive encryption - don't encrypt" at 1367 810, waiting 15s, named "drive encryption - don't encrypt"
  step "the install has started"
    loop == {check: {from: started, mode: text, name: begun, rect: [491, 722, 598, 784], rect_at: [1920, 1080], scale: 3, words: [[Extracting], [Installing], [Copying]]}, do: [{settle: 6}], max: 20, see: {name: started}, until: {fact: begun}}
    settle == 35
  step "the install is written"
    disk_min_mb == 512
    disk_settle == 180
    poll == 20
    timeout == 3600
  step "stop the machine"
    shutdown == kill
    timeout == 120
  step "publish the disk"
    compress == '{{ out }}'
