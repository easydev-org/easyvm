walkthrough "fedora-workstation - anaconda and the first boot"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user


step "the media this stage boots from is already on disk"
  needs [fedora-workstation.iso]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the installer"
  boot
  iso fedora-workstation.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800


step "wait for the live desktop"
  desktop linux/gnome
  poll 5
  range [0.9, 1]
  # THE REFERENCE IS THIS BOOT'S OWN DESKTOP, AND THE BAND IS THE BOTTOM OF THE SCREEN.
  #
  # MEASURED ON RUN 44519496307, WHICH NEVER SATISFIED THE GATE WHILE ITS DESKTOP WAS UP:
  #
  #	t=300   a complete GNOME session - the welcome dialog, the Dock, the top bar
  #	t>=350  black, because the guest blanks its own display
  #
  # and every frame scored 0.0000 against the old reference, whose wall paper is a DIFFERENT PIECE
  # OF ART (the shipped one is the gold-gears splash art; this boot draws a pale gradient behind an
  # Overview that is scaling the wall paper down and blurring it). Two different pictures, so no
  # band could have matched both.
  #
  # THE REFERENCE IS NOW THAT FRAME. THE BAND IS ROWS 820..1020, the wall paper below the Overview's
  # app grid and above the Dock: 1.0000 on every desktop frame from 60 s, 0.0002 on the boot and
  # splash frames before it.
  #
  # AND THE SCREEN BLANKS AT ABOUT 350 s, which is why the gate has to open early: `poll: 5` is what
  # gives it that chance, and it is already there.
  rect [0, 820, 1920, 1020]
  rect_at [1920, 1080]
  reference reference/desktop.png
  timeout 5400


step "a pointer nudge on the wallpaper, so the idle timer starts again"
  input 960 300
  settle 20


step "answer the live session's welcome dialog"
  repeat
    pause 5
    until
      bind offered
      source welcome_dialog
      mode text
      rect [773, 536, 1001, 639]
      rect_at [1920, 1080]
      scale 1
      words [[Welcome], [Install]]
    max 30


step "launch the installer"
  input 830 698
  settle 25


step "anaconda's web ui is up"
  repeat
    pause 10
    until
      bind ready
      source anaconda
      mode text
      rect [538, 72, 725, 143]
      rect_at [1920, 1080]
      scale 1
      words [[Workstation], [Encryption]]
    max 60


step "open the language search"
  input 938 224
  settle 2


step "search for the United States"
  settle 4
  input text "united states"


step "choose English (United States)"
  input 853 314
  settle 6


step "the wizard is in English now"
  read
    name english


step "it speaks English"
  check
    source english
    mode text
    name ok
    rect [353, 146, 978, 214]
    rect_at [1920, 1080]
    scale 1
    words [[Welcome], [now]]


step "welcome"
  input 726 999
  settle 15


step "the installation method page"
  read
    name method


step "that page asks how to install"
  check
    source method
    mode text
    name asking
    rect [623, 226, 931, 477]
    rect_at [1920, 1080]
    scale 1
    words [[Destination], [Encryption], [storage]]


step "open the storage editor, which is the only place a filesystem can be chosen"
  input 928 446
  settle 8


step "launch it"
  input 794 642
  settle 20


step "the editor is up"
  repeat
    pause 10
    until
      bind up
      source blivet
      mode text
      rect [610, 186, 1431, 344]
      rect_at [1920, 1080]
      scale 1
      words [[Requirements], [Unformatted], [Type]]
    max 60


step "the disk's menu"
  input 1185 328
  settle 4


step "create the partition table"
  input 1117 480
  settle 6


step "initialize it as GPT, which is the default"
  input 474 381
  settle 8


step "the free space's menu"
  input 1185 363
  settle 4


step "the free space menu is open"
  repeat
    pause 2
    until
      bind up
      source the_free_space_menu_is_open
      mode text
      rect [1000, 380, 1360, 460]
      rect_at [1920, 1080]
      scale 1
      words [[Create], [Format], [Delete]]
    max 12


step "create the root partition"
  input 1132 405
  settle 8


step "the root dialog is up"
  repeat
    pause 2
    until
      bind up
      source the_root_dialog_is_up
      mode text
      rect [380, 320, 1100, 650]
      rect_at [1920, 1080]
      scale 1
      words [[Create], [Type], [Mount]]
    max 12


step "name it root"
  input text root
    at 882 271
  settle 2


step "mount it at the root"
  input text /
    at 882 333
  settle 2


step "create it, taking the dialog's own ext4 default"
  input 441 628
  settle 8


step "the root partition exists"
  repeat
    pause 4
    until
      bind there
      source part1
      mode text
      rect [618, 331, 693, 389]
      rect_at [1920, 1080]
      scale 1
      words [[vda1], [ext4]]
    max 20


step "open the root partition's detail page"
  input 460 363
  settle 6


step "the detail page is up"
  repeat
    pause 2
    until
      bind up
      source detail
      mode text
      rect [390, 330, 1040, 410]
      rect_at [1920, 1080]
      scale 1
      words [[UUID], [filesystem]]
    max 12


step "shrink it from the detail page"
  input 1008 267
  settle 6


step "the shrink dialog is up"
  repeat
    pause 2
    until
      bind up
      source shrink_dialog
      mode text
      rect [400, 200, 950, 350]
      rect_at [1920, 1080]
      scale 1
      words [[Shrink], [Size]]
    max 12


step "shrink it"
  input 1029 562
  settle 6


step "to 136 GB, leaving room for the ESP"
  input 1041 275
  settle 1


step "replace the size"
  input ctrl+a
  settle 1


step "the size the shrink dialog is given"
  settle 2
  input text "136"


step "confirm the shrink"
  input 456 337
  settle 8


step "back to the partition list"
  input 427 222
  settle 6


step "the list is up, with free space on it"
  repeat
    pause 2
    until
      bind up
      source back_at_list
      mode text
      rect [618, 277, 694, 354]
      rect_at [1920, 1080]
      scale 1
      words [[Unformatted], [GPT]]
    max 12


step "the new free space's menu"
  # SAME MENU AS STEP 24, SAME PLACE: the small pop-up under the row's three-dot button, at
  # x 1070..1200, y 396..418. This rect was [411,194,519,257] - the top-left of the page.
  # MEASURED on run 44532343964's own recording, whose last frame has that menu open.
  repeat
    do
      item
        input 1185 407
        settle 3
    until
      bind open
      source fs_menu
      mode text
      rect [1030, 380, 1350, 460]
      rect_at [1920, 1080]
      scale 1
      words [[Create]]
    max 6


step "create the ESP"
  input 1132 449
  settle 8


step "the ESP dialog is up"
  repeat
    pause 2
    until
      bind up
      source esp_dialog
      mode text
      rect [571, 485, 700, 599]
      rect_at [1920, 1080]
      scale 1
      words [[Overwrite], [Encryption]]
    max 12


step "set the type to the ESP"
  repeat
    do
      item
        input 882 396
        settle 3
      item
        input 648 576
        settle 3
    until
      bind esp
      source type_now
      mode text
      rect [560, 380, 1400, 420]
      rect_at [1920, 1080]
      scale 1
      words [[partition]]
    max 6


step "name it boot - click the field"
  input 882 271


step "name it boot - select what is there"
  input ctrl+a
  settle 1


step "name it boot - delete the selection"
  input backspace
  settle 1


step "name it boot - type the value"
  input text boot
  settle 2

step "create it, and the mount point is filled in for us"
  input 456 566
  settle 10


step "the ESP exists"
  repeat
    pause 4
    until
      bind there
      source part2
      mode text
      rect [1343, 466, 1403, 523]
      rect_at [1920, 1080]
      scale 2
      words [[vda2], [EFI]]
    max 20


step "back to the installer"
  input 450 975
  settle 12


step "accept the layout it detected"
  input 756 337
  settle 15


step "the review page, which now names this storage"
  read
    name review


step "the review names a configured layout"
  check
    source review
    mode text
    name configured
    rect [621, 600, 735, 661]
    rect_at [1920, 1080]
    scale 1
    words [[configured], [Review]]


step "next from the installation method"
  repeat
    do
      item
        input 730 999
        settle 12
    until
      bind here
      source review_page
      mode text
      rect [353, 266, 443, 324]
      rect_at [1920, 1080]
      scale 3
      words [[Review]]
    max 4


step "close any quit dialog"
  input esc
  settle 3


step "press install"
  repeat
    do
      item
        input 730 999
        settle 15
    until
      bind begun
      source install_started
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 3
      words [[Installing]]
    max 4


step "the install is written"
  disk_min_mb 512
  disk_settle 180
  poll 20
  timeout 3600


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
