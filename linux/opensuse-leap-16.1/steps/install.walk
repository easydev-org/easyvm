walkthrough "opensuse-leap-16.1 - Agama, the storage editor, and ext4"
resolution 1920x1080
recording_resolution 1920x1080
var desktop_password
  default Qz7vLp2w
  from args.password
var out
  default out/distro.qcow2
  from args.out
password Qz7vLp2w
var user
  default vmuser
  from args.user
notes "Its installer is a form-only installer: Agama is a WEB UI the live session opens straight into, with no panel at any point. MEASURED, the two frames before the product chooser give `drop` 0.0 and 6.9 where `IsLinuxDesktop` wants more than 15 - see TestAnInstallerIsWaitedForTheWayItAppears.\n"

step "the media this stage boots from is already on disk"
  needs [opensuse-leap-16.1.iso]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the installer"
  boot
  iso opensuse-leap-16.1.iso
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 4096
  os linux
  timeout 1800

step "wait for the installer's product chooser to draw"
  repeat
    pause 6
    until
      bind up
      from chooser
      mode text
      rect [45, 125, 242, 561]
      rect_at [1920, 1080]
      scale 1
      words [[Select], [mode]]
    max 40

step "choose the product"
  press 66 199
  settle 5

step "choose the Standard system"
  press 94 324
  settle 3

step "accept the licence"
  press 47 420
  settle 3

step "select it"
  press 160 470
  settle 20

step "wait for the installer's summary to draw"
  repeat
    pause 6
    until
      bind up
      from summary
      mode text
      rect [43, 71, 434, 593]
      rect_at [1920, 1080]
      scale 1
      words [[Installation], [Storage]]
    max 40

step "open the storage section"
  press 120 387
  settle 10

step "open the mount list"
  press 455 330
  settle 6

step "the root row's menu"
  press 850 420
  settle 5

step "edit it"
  press 792 458
  settle 8

step "open the filesystem list"
  press 87 502
  settle 6

step "choose ext4"
  press 79 744
  settle 6

step "accept the partition"
  press 61 632
  settle 8

step "back to the summary"
  press 72 29
  settle 10

step "open the authentication section"
  press 758 390
  settle 3

step "define an administrator user"
  press 73 275
  settle 6

step "the full name"
  press text "{{ user }}"
    at 207 366
  settle 2

step "the user name"
  press text "{{ user }}"
    at 207 460
  settle 2

step "the password"
  press text "{{ password }}"
    at 207 553
  settle 2

step "the password again"
  press text "{{ password }}"
    at 207 673
  settle 3

step "scroll the form to its buttons, by tabbing focus down it"
  press tab
  settle 1

step "tab 1 of the scroll"
  press tab
  settle 1

step "tab 2 of the scroll"
  press tab
  settle 1

step "tab 3 of the scroll"
  press tab
  settle 1

step "tab 4 of the scroll"
  press tab
  settle 1

step "tab 5 of the scroll"
  press tab
  settle 1

step "tab 6 of the scroll"
  press tab
  settle 1

step "tab 7 of the scroll"
  press tab
  settle 1

step "tab 8 of the scroll"
  press tab
  settle 1

step "tab to Accept, which scrolls it into view"
  press tab
  settle 2

step "accept the account"
  press 92 1016
  settle 10

step "the changes are applied"
  read
    name auth_applied

step "changes were applied"
  expect
    from auth_applied
    mode text
    name applied
    rect [132, 73, 338, 138]
    rect_at [1920, 1080]
    scale 1
    words [[applied], [successfully]]

step "back to the summary, where install is now enabled"
  press 177 129
  settle 10

step "start the install"
  press 110 515
  settle 20

step "confirm, because this medium asks"
  press 756 669
  settle 30

step "the install is written"
  disk_min_mb 2000
  disk_settle 300
  poll 20
  timeout 3600

step "the install finishes"
  repeat
    pause 15
    until
      bind finished
      from done
      mode text
      rect [600, 500, 1300, 620]
      rect_at [1920, 1080]
      scale 1
      words [[complete], [reboot]]
    max 120

step "stop the machine"
  stop kill
  timeout 600

step "publish the disk"
    save "{{ out }}"
