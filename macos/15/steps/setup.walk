walkthrough "macos 15 setup (recovery image to setup assistant)"
resolution 1920x1080
recording_resolution 1920x1080
var disk_name
  default main
var expected_gb
  default "68"
var out
  default out/macos15.qcow2
  from args.out
var shutdown
  default kill
  from args.shutdown


step "the media this stage boots from is already on disk"
  needs [recovery.dmg, boot.img, macos.rom, macos.vars]


step "create the empty disk"
  disk disk.qcow2
  disk_gb 128


step "boot the recovery image"
  boot
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 12288
  os macos
  recovery recovery.dmg
  timeout 900


step "the recovery menu's rows"
  read recovery


step "wait for the recovery menu"
  repeat
    pause 10
    until
      bind done
      source recovery
      mode text
      rect [760, 200, 1400, 560]
      rect_at [1920, 1080]
      scale 6
      words [[restore, time, machine], [reinstall, macos], [safari], [disk, utility]]
    max 180


step "select disk utility"
  input 837 514
  settle 3


step "open disk utility"
  input 1142 586
  settle 5


step "make disk utility full screen"
  at_color [40, 200, 64]
  color_region [0, 30, 700, 400]
  color_tolerance 45
  settle 6


step "read the first disk"
  input 200 112
  settle 2


step "is the first disk the uninitialised one"
  read details


step "the first disk is the uninitialised one"
  check
    source details
    mode contains
    name uninitialised
    rect [360, 100, 1000, 160]
    rect_at [1920, 1080]
    scale 4
    text Uninitialized


step "step down to the uninitialised disk"
  if uninitialised
    else
      item
        repeat
          do
            item
              input down
            item
              settle 1
          until
            bind uninitialised
            source details
            mode contains
            rect [360, 100, 1000, 160]
            rect_at [1920, 1080]
            scale 4
            text Uninitialized
          max 4


step "erase - open the sheet"
  repeat
    do
      item
        input 1681 57
      item
        settle 3
    until
      bind sheet_up
      source sheet
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[erase, deleted], [free, space], [security, option], [cancel, erase]]
    max 6
  settle 4


step "erase - clear the name field"
  input backspace
  settle 3


step "erase - name the volume"
  input text "{{ disk_name }}"
    at 960 415
  settle 4


step "erase - confirm"
  input 1150 647
  settle 5


step "erase - wait for the report"
  repeat
    pause 5
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[erase, complete], [erase, process]]
    max 60


step "erase - done"
  input 1143 601
  settle 5


step "close disk utility"
  input meta_l+q
  settle 12


step "the recovery menu is back"
  repeat
    pause 5
    until
      bind done
      source screen
      mode text
      rect [813, 300, 1007, 374]
      rect_at [1920, 1080]
      words [reinstall, macos]
    max 60


step "select reinstall macos"
  input 837 333
  settle 3


step "open the installer"
  input 1142 586
  settle 20


step "wait for the installer to load"
  repeat
    pause 10
    until
      bind loaded
      source instaload
      mode text
      rect [600, 520, 1300, 640]
      rect_at [1920, 1080]
      words [[agree, to, the, terms], [english, apple], [select, the, disk], [macos, sequoia]]
    max 24


step "welcome continue"
  input 960 712
  settle 5


step "wait for the licence pane"
  repeat
    pause 10
    until
      bind licence_up
      source licence
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[software, license, agreement], [please, read, this]]
    max 24


step "agree to the licence"
  input 1005 713
  settle 5


step "wait for the licence sheet"
  repeat
    pause 5
    until
      bind sheet_up
      source sheet
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[read, and, agree], [disagree, agree]]
    max 12


step "agree in the sheet"
  input 1018 520
  settle 10


step "select the destination card"
  input 850 550
  settle 5


step "destination continue"
  input 1005 712
  settle 10


step "the copy runs until the Setup Assistant appears"
  repeat
    pause 20
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[select, your, country, or, region], [how, do, you, want, to, connect, to, the, internet], [transfer, your, information, to, this, mac], [choose, a, wireless, network], [sign, in, with, your, apple, id]]
    max 1080


step "stop the machine"
  stop "{{ shutdown }}"
  timeout 300


step "publish the disk"
    save "{{ out }}"
