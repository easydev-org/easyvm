walkthrough "macos 26 setup (recovery image to setup assistant)"
resolution 1920x1080
recording_resolution 1920x1080
var disk_name
  default main
var expected_gb
  default "68"
var out
  default out/macos26.qcow2
  from args.out
var shutdown
  default kill
  from args.shutdown

step "the media this stage boots from is already on disk"
  needs [recovery.dmg, boot.img, macos.rom, macos.vars]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the recovery image"
  boot
  memory_mb 12288
  os macos
  recovery recovery.dmg
  timeout 900

step "the recovery menu's rows"
  read
    name recovery

step "wait for the recovery menu"
  repeat
    pause 10
    until
      bind done
      source recovery
      mode text
      rect [760, 200, 1400, 560]
      rect_at [1920, 1080]
      scale 6
      words [[restore, time, machine], [reinstall, macos], [safari], [disk, utility]]
    max 180

step "select disk utility"
  input 800 523
  settle 3

step "open disk utility"
  input 1148 595
  settle 8

step "make disk utility full screen"
  at_color [40, 200, 64]
  color_region [0, 30, 700, 400]
  color_tolerance 45
  settle 6

step "select the first disk"
  input 200 132
  settle 2

step "is the selected disk the uninitialised one"
  read
    name details

step "the first disk is the uninitialised one"
  check
    source details
    mode contains
    name uninitialised
    rect [360, 105, 1100, 200]
    rect_at [1920, 1080]
    scale 4
    text Uninitialized

step "select the second disk, when row 1 was the boot image"
  if uninitialised
    else
      item "click row 2"
        input 200 164
        settle 2
      item "is the second disk the uninitialised one"
        read
          name details
      item "the second disk is the uninitialised one"
        check
          source details
          mode contains
          name uninitialised
          rect [360, 105, 1100, 200]
          rect_at [1920, 1080]
          scale 4
          text Uninitialized

step "erase - open the sheet"
  repeat
    do
      item
        input 1711 56
      item
        settle 3
    until
      bind sheet_up
      source sheet
      mode text
      rect [720, 425, 1200, 680]
      rect_at [1920, 1080]
      scale 2
      words [[erase, deleted], [free, space], [security, option], [cancel, erase]]
    max 6
  settle 4

step "erase - clear the name field"
  input meta_l+a
  settle 1

step "erase - name the volume"
  input text "{{ disk_name }}"
    at 988 542
  settle 4

step "erase - confirm"
  input 1154 650
  settle 5

step "erase - wait for the report"
  repeat
    pause 5
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[erase, complete], [erase, process]]
    max 60

step "erase - done"
  input 1147 614
  settle 5

step "close disk utility"
  input meta_l+q
  settle 12

step "the recovery menu is back"
  repeat
    pause 5
    until
      bind done
      source screen
      mode text
      rect [760, 200, 1400, 560]
      rect_at [1920, 1080]
      scale 2
      words [[reinstall, macos]]
    max 60

step "select reinstall macos"
  input 837 333
  settle 3

step "open the installer"
  input 1142 586
  settle 20

step "wait for the installer to load"
  repeat
    pause 10
    until
      bind loaded
      source instaload
      mode text
      rect [400, 560, 1520, 700]
      rect_at [1920, 1080]
      scale 2
      words [[agree, to, the, terms], [english, apple], [select, the, disk], [macos]]
    max 24

step "welcome continue"
  input 960 712
  settle 5

step "wait for the licence pane"
  repeat
    pause 10
    until
      bind licence_up
      source licence
      mode text
      rect [660, 430, 1260, 700]
      rect_at [1920, 1080]
      scale 2
      words [[software, license, agreement], [please, read, this]]
    max 24

step "agree to the licence"
  input 1005 713
  settle 5

step "wait for the licence sheet"
  repeat
    pause 5
    until
      bind sheet_up
      source sheet
      mode text
      rect [780, 330, 1140, 560]
      rect_at [1920, 1080]
      scale 2
      words [[read, and, agree], [disagree, agree]]
    max 12

step "agree in the sheet"
  input 1018 520
  settle 10

step "select the destination card"
  input 850 550
  settle 5

step "destination continue"
  input 1005 712
  settle 10

step "the copy runs, look 1 of at most 8"
  repeat
    do
      item
        settle 20
      item "read the pane for the cancel sheet"
        read
          name cancelshot
      item "classify - the cancel confirmation"
        check
          source cancelshot
          mode text
          name cancel_sheet
          rect [820, 300, 1100, 600]
          rect_at [1920, 1080]
          scale 1
          words [[continue, installing]]
      item "answer the cancel confirmation"
        if cancel_sheet
          then
            item "continue installing"
              input 960 508
              settle 10
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 270
    nudge 5400
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "reset the guest after look 1, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300

step "wait for the guest to be drawing again after reset 1"
  repeat
    pause 10
    until
      bind anything1
      source back1
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40

step "the copy runs, look 2 of at most 8"
  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "reset the guest after look 2, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300

step "wait for the guest to be drawing again after reset 2"
  repeat
    pause 10
    until
      bind anything2
      source back2
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40

step "the copy runs, look 3 of at most 8"
  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "reset the guest after look 3, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300

step "wait for the guest to be drawing again after reset 3"
  repeat
    pause 10
    until
      bind anything3
      source back3
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40

step "the copy runs, look 4 of at most 8"
  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "reset the guest after look 4, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300

step "wait for the guest to be drawing again after reset 4"
  repeat
    pause 10
    until
      bind anything4
      source back4
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40

step "the copy runs, look 5 of at most 8"
  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "reset the guest after look 5, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300

step "wait for the guest to be drawing again after reset 5"
  repeat
    pause 10
    until
      bind anything5
      source back5
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40

step "the copy runs, look 6 of at most 8"
  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

