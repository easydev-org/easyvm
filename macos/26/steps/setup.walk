  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "reset the guest after look 7, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300

step "wait for the guest to be drawing again after reset 7"
  repeat
    pause 10
    until
      bind anything7
      source back7
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40

step "the copy runs, look 8 of at most 8"
  repeat
    pause 20
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60

step "the Setup Assistant is on screen, which is what this stage exists to reach"
  read
    name final

step "the Setup Assistant is up, OR THIS STAGE FAILS"
  until_any [[select, your, country, or, region], [how, do, you, want, to, connect, to, the, internet], [transfer, your, information, to, this, mac], [choose, a, wireless, network], [sign, in, with, your, apple, id]]

step "stop the machine"
  stop "{{ shutdown }}"
  timeout 300

step "publish the disk"
    save "{{ out }}"
