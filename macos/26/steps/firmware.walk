walkthrough "macos 26 - build the firmware once and publish it"
  var release == {default: "26", from: args.release}
  header recording_resolution == [1920, 1080]

  needs recovery.dmg, named "the recovery image this build reads is already on disk"
  step "build the firmware the guest boots through"
    fetch == opencore
    recovery == recovery.dmg
    release == "26"
