walkthrough "macos 26 - configure the vm (guest agent, names, login agent, auto login)"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var hostname
  default easyvm-macos26
  from args.hostname
var out
  default out/distro.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222

step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars, mac-guest-agent]

  # THIS FILE IS macos/15's vm-configure WITHOUT FIVE THINGS, AND BOTH ARE MEASURED RATHER THAN GUESSED.
  #
  # A probe run against the disk the ssh stage publishes answered for 26:
  #
  #	sw_vers                    26.7.3  (25G342)  x86_64
  #	/etc/localtime   ->        .../zoneinfo/America/Los_Angeles      ALREADY RIGHT
  #	defaults AppleLocale       en_US  AppleLanguages (en-US)         ALREADY RIGHT
  #	fdesetup status            FileVault is Off                       auto login is ALLOWED
  #	scutil LocalHostName       vmuser                                 set by the ssh stage
  #
  #	scutil HostName            NOT SET          <- step below
  #	scutil ComputerName        "vmuser's iMac"  <- installer default, step below
  #	~/Library/LaunchAgents     DOES NOT EXIST   <- `mkdir -p` is not optional
  #	/etc/kcpassword            ABSENT           <- auto login, step below
  #	pmset displaysleep         10               <- step below
  #	/dev/cu.serial1            PRESENT, crw-rw-rw-   <- the port mac-guest-agent probes for
  #
  # SO THE TIME ZONE, THE LOCALE AND THE FILEVAULT CHECK ARE NOT REPEATED HERE. They were steps in the
  # 15 file because 15's ssh stage did not do them; 26's does, and a step that re-does work is a step
  # whose failure says nothing about the disk.
step "boot the disk"
  boot
  # A FIXED SIZE FOR EVERY GUEST OF THIS FAMILY: see the header comment.
  memory_mb 12288
  os macos
  timeout 900

step "wait for sshd"
  require_ssh
  timeout 900

  # --- what the guest already is -------------------------------------------------------------
  #
  # SAID OUT LOUD IN THE LOG rather than assumed, because every step below depends on it: `sudo` over
  # this channel has no tty, `/dev/cu.serial1` has to exist for the agent, and FileVault has to be off
  # for auto login to be allowed at all.
step "note what the ssh stage already set, before changing anything"
  ssh "sh -c 'sw_vers -productVersion; uname -m; echo \"--- names ---\"; for k in HostName LocalHostName ComputerName; do printf \"%s = %s\\n\" \"$k\" \"$(scutil --get $k 2>&1)\"; done; echo \"--- zone and locale ---\"; readlink -f /etc/localtime; defaults read NSGlobalDomain AppleLocale; echo \"--- filevault ---\"; fdesetup status | head -1; echo \"--- the agent port ---\"; ls -l /dev/cu.serial* 2>&1'"
  timeout 120

  # --- 1. the guest agent --------------------------------------------------------------------
  #
  # A PREPARED INPUT: the workflow pulls `macos-asset-mac-guest-agent` before this stage starts. A
  # download in the middle of a boot is a download that can outlast the boot budget.
step "copy the agent into the guest"
  copy mac-guest-agent /tmp/mac-guest-agent
  timeout 300

step "install the guest agent"
  ssh "chmod +x /tmp/mac-guest-agent &&\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' /tmp/mac-guest-agent --install 2>&1 | tail -12 &&\nsleep 5 &&\n(printf '%s\\n' '{{ password }}' | sudo -S -p '' launchctl print system/org.mav2287.mac-guest-agent 2>&1 | head -6 ||\nprintf '%s\\n' '{{ password }}' | sudo -S -p '' pgrep -fl mac-guest-agent)\n"
  timeout 600

step "prove the guest agent answers"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' pgrep -fl mac-guest-agent &&\necho '--- serial ports the agent can use ---' &&\nls -l /dev/cu.serial* 2>/dev/null &&\necho '--- what it logged ---' &&\n(printf '%s\\n' '{{ password }}' | sudo -S -p '' tail -8 /var/log/mac-guest-agent.log 2>/dev/null || true)\n"
  timeout 120

  # --- 2. the machine's names ----------------------------------------------------------------
  #
  # macOS HAS THREE NAMES AND THEY ARE NOT THE SAME THING. A walkthrough that sets only HostName gets
  # a guest whose prompt, Bonjour name and Finder label all still say the installer's default:
  #
  #	HostName        what `hostname` answers and what ssh reports   <- the probe found this NOT SET
  #	LocalHostName   the Bonjour name, no dots, 63 characters       <- already `vmuser`
  #	ComputerName    the label a person sees                        <- `vmuser's iMac`
  #
  # `{{ hostname }}` has hyphens and no dot, so the same string is legal for all three.
step "set the machine's name, all three of it"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c 'scutil --set HostName {{ hostname }}; scutil --set LocalHostName {{ hostname }}; scutil --set ComputerName {{ hostname }}'"
  timeout 180

step "prove the name, all three of it"
  ssh "sh -c 'for k in HostName LocalHostName ComputerName; do printf \"%s = %s\\n\" \"$k\" \"$(scutil --get $k)\"; done; test \"$(scutil --get HostName)\" = \"{{ hostname }}\" && echo HOSTNAME_OK'"
  timeout 60

  # --- 3. the host share ---------------------------------------------------------------------
  #
  # THE LAUNCHER BELOW FETCHES ITS SCRIPT OVER HTTP FROM THIS SHARE, so the share has to be up and
  # PROVEN before the login agent is installed - otherwise the agent installs and its first run fails
  # for a reason three steps away.
  #
  # THE TRANSPORT IS THE DAEMON'S OWN HTTP LISTENER, not SMB. `mount_smbfs` refuses a non-root client
  # against this server and needed a LaunchDaemon to re-mount at every boot; a plain `curl` needs no
  # root, no mount and no daemon.
step "prove the guest can fetch from the host share"
  ssh "sh -c 'curl -fsS --max-time 20 http://172.30.0.1:8080/shared/ || wget -qO- --timeout=20 http://172.30.0.1:8080/shared/'"
  timeout 180

step "show what the guest sees at the share"
  ssh "sh -c 'curl -fsS --max-time 20 http://172.30.0.1:8080/shared/ 2>&1 | head -20; echo \"fetch exit = $?\"'"
  timeout 120

  # --- 4. the login agent --------------------------------------------------------------------
step "copy the launcher in"
  copy
    template launcher
    to /tmp/bootstrap-launcher.sh
  timeout 180

step "copy the login agent plist in"
  copy
    template macos_agent_plist
    to /tmp/bootstrap.plist
  timeout 180

step "install the login agent"
  # `mkdir -p` IS NOT OPTIONAL ON THIS GUEST: the probe found `~/Library/LaunchAgents` does not
  # exist, and a plist written into a directory that is not there is a file nothing reads - with no
  # error.
  ssh "set -e\nlaunchd_home=$(eval echo \"~$(id -un)\")\nmkdir -p \"$launchd_home/Library/LaunchAgents\"\ncp /tmp/bootstrap-launcher.sh \"$launchd_home/bootstrap-launcher.sh\"\nchmod +x \"$launchd_home/bootstrap-launcher.sh\"\nsed 's|__LAUNCHER__|'\"$launchd_home\"'/bootstrap-launcher.sh|' /tmp/bootstrap.plist > \"$launchd_home/Library/LaunchAgents/org.vm.bootstrap.plist\"\necho INSTALLED_FOR_NEXT_LOGIN\n"
  timeout 300

step "prove the login agent is installed and loads"
  # THE PLIST IS LINTED AND THE JOB IS ASKED FOR BY NAME, because a LaunchAgent that exists and does
  # not parse is one that never fires - and the failure is silent.
  ssh "ls -l ~/Library/LaunchAgents/org.vm.bootstrap.plist ~/bootstrap-launcher.sh &&\nplutil -lint ~/Library/LaunchAgents/org.vm.bootstrap.plist &&\n(launchctl print gui/$(id -u)/org.vm.bootstrap 2>&1 | head -6 ||\necho 'not loaded yet; it loads at next login')\n"
  timeout 120

step "prove the launcher fetches, by running it now"
  # THE AGENT RUNS AT LOGIN, SO ITS OWN SCRIPT IS RUN HERE IN THE SAME WAY. That is the difference
  # between "the file was installed" and "the file works": the fetch, the marker and the log are all
  # exercised, and the log is read back.
  ssh "sh -c '/bin/sh ~/bootstrap-launcher.sh 2>&1 | head -5; echo \"--- log ---\"; tail -8 ~/bootstrap.log 2>/dev/null || echo \"(no log)\"'"
  timeout 180

  # --- 5. automatic login --------------------------------------------------------------------
  #
  # macOS HAS NO `autologin-user` FILE. Auto login is a 12-byte-multiple file at `/etc/kcpassword`
  # holding the password XOR'd against Apple's fixed key, plus one key in the loginwindow preferences
  # - and missing EITHER half leaves the machine at a password prompt.
  #
  # THE KEY IS APPLE'S OWN, published in every write-up of this file:
  #
  #	0x7D 0x89 0x52 0x23 0xD2 0xBC 0xDD 0xEA 0xA3 0xB9 0x1F
  #
  # THE PADDING IS PART OF THE FORMAT: the payload is the password, then NULs, up to a multiple of 12
  # bytes - an 8-character password becomes 12. A file that is not a multiple of 12 makes kcpassword's
  # own reader stop early, and the effect is a login that does not happen with no error anywhere.
  #
  # `perl` RATHER THAN `python3`: macOS ships no python3 that can install anything and this repository
  # refuses one (`python3` is refused by policy), while perl is in the base system.
  #
  # `chmod 600 root:wheel` BECAUSE loginwindow REFUSES A FILE ANYONE ELSE CAN READ, silently.
step "write the automatic login password, XOR'd against Apple's fixed key"
  ssh "printf '%s' '{{ password }}' | perl -e 'my $key = pack(\"C*\", 0x7d,0x89,0x52,0x23,0xd2,0xbc,0xdd,0xea,0xa3,0xb9,0x1f); my $pw = <STDIN>; chomp $pw; my @b = unpack(\"C*\", $pw); my $n = ((int(@b / 12) + 1) * 12); push @b, (0) x ($n - @b); my $k = 0; my $out = \"\"; for my $c (@b) { $out .= sprintf(\"%02x\", $c ^ ord(substr($key, $k % 12, 1))); $k++ } print $out' > /tmp/kcpassword.hex && printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c 'perl -e \"print pack(q{H*}, do { local $/; <STDIN> })\" < /tmp/kcpassword.hex > /etc/kcpassword && chown root:wheel /etc/kcpassword && chmod 600 /etc/kcpassword' && ls -l /etc/kcpassword && echo KCPASSWORD_WRITTEN"
  timeout 180

step "give loginwindow the other half, without which macOS shows the lock screen anyway"
  # `autoLoginUserScreenLocked = 0` IS THE SECOND HALF AND IT IS EASY TO MISS: without it macOS logs
  # the user in and then IMMEDIATELY presents the lock screen, which from the outside is
  # indistinguishable from auto login not working at all.
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' defaults write /Library/Preferences/com.apple.loginwindow autoLoginUser -string '{{ user }}'; printf '%s\\n' '{{ password }}' | sudo -S -p '' defaults write /Library/Preferences/com.apple.loginwindow autoLoginUserScreenLocked -bool false; echo AUTOLOGIN_CONFIGURED"
  timeout 120

step "prove both halves are in place"
  # BOTH ARE READ BACK, because either one being wrong is a password prompt and neither one is an
  # error: `stat -f%z` shows the file is a multiple of 12, and the two `defaults read` lines show the
  # user and the screen-locked flag.
  ssh "sh -c 'stat -f \"%z bytes\" /etc/kcpassword; stat -f \"%Sp %Su\" /etc/kcpassword; printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser; printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" defaults read /Library/Preferences/com.apple.loginwindow autoLoginUserScreenLocked'"
  timeout 120

  # --- 6. do not sleep -----------------------------------------------------------------------
  #
  # `pmset` NEEDS SUDO AND HAS NO UNPRIVILEGED FORM. The screen saver's idle time is a SEPARATE
  # domain - `com.apple.screensaver idleTime` - and setting only `pmset` leaves a guest whose display
  # stays on and whose saver still covers it. The probe found `displaysleep 10` and `sleep 10`.
step "turn off display sleep and the screen saver"
  ssh "sh -c 'printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" pmset displaysleep 0 sleep 0; defaults -currentHost write com.apple.screensaver idleTime 0; echo SLEEP_DISABLED'"
  timeout 180

step "prove the machine will not go to sleep"
  # `pmset -g custom` PRINTS THE EFFECTIVE VALUES, which is what matters: the command above can exit
  # 0 and be ignored if another profile overrides it.
  ssh "pmset -g custom | grep -iE \"displaysleep|sleep\" | head -4; defaults -currentHost read com.apple.screensaver idleTime\n"
  timeout 120

step "note what is present"
  ssh "sh -c 'echo \"hostname=$(scutil --get HostName)\"; echo \"computer=$(scutil --get ComputerName)\"; echo \"agent=$(pgrep -fl mac-guest-agent | head -1)\"; echo \"autologin=$(printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>&1)\"'"
  timeout 120

  # `shutdown: ssh`, FOR THE REASON macos/15's file already records.
  #
  # MEASURED ON RUN 44474459141, that stage, step 22:
  #
  #	ssh: printf '%s\n' 'admin' | sudo -S -p '' poweroff -> 1
  #	  sudo: poweroff: command not found
  #
  # `/sbin` is not on sudo's secure_path here, so the binary was never found. `shutdown:` is the
  # executor's own method: it sends the command by a route that does not need the binary on PATH and
  # tolerates the connection ending, which a working shutdown always does.
step "stop the machine"
  stop ssh
  timeout 300

step "wait for the machine to stop"
  wait_until stopped
  timeout 300

step "publish the disk"
    save "{{ out }}"
