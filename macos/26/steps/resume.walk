walkthrough "macos 26 - start the disk that is already there"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/mac26.qcow2
  from args.out
boot_disk from_caller


step "the recovery image this boot reads is already on disk"
  needs [recovery.dmg]


step "boot the disk that is already there"
  boot
  memory_mb 12288
  os macos
  recovery recovery.dmg
  timeout 900
