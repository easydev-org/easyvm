walkthrough "freebsd 15.1 - sshd, XFCE, and a desktop"
  resolution 1920x1080
  recording_resolution 1920x1080
  user vmuser
  password admin
  var out == {default: out/freebsd-ssh.qcow2, from: args.out}
  var user == {default: vmuser, from: args.user}
  header ssh_port == 2222

  step "boot the disk"
    boot == true
    memory_mb == 8192
    os == bsd
    timeout == 900
  step "wait for sshd"
    require_ssh == true
    timeout == 600
  step "prove the kernel over ssh"
    ssh == uname -a
  step "prove the account over ssh"
    ssh == id -un
  # A BOOTED SYSTEM HAS NO RESOLVER AND NO PACKAGE REPOSITORY; THE INSTALL STAGE'S COPIES DID NOT
  # SURVIVE THE BOOT.
  #
  # THE INSTALL WALK WRITES BOTH INTO THE CHROOT IT IS INSTALLING, so that its own pkgbase step can
  # run. The guest then shuts down and this stage boots the disk, where `/etc/resolv.conf` is EMPTY
  # again and the repo file was never part of the image.
  #
  # MEASURED:
  #
  #	status: failed step 5/16 "install xfce and the display manager"
  #	error:   install xfce and the display manager: the command exited 1
  #	ssh: sudo env ASSUME_ALWAYS_YES=yes pkg install -y xorg xfce lightdm lightdm-gtk-greeter -> 1
  #
  # `pkg` exits 1 when it cannot resolve or reach a mirror, which is what a booted FreeBSD with an
  # empty resolv.conf does. The bytes are the same ones the install step uses, carried as base64 so
  # the quoting of a FreeBSD repo file does not have to survive three layers of shell.
  step "give the booted system a resolver"
    ssh == echo cHJpbnRmICclc1xuJyAnbmFtZXNlcnZlciAxNzIuMzAuMC4xJyA+IC9ldGMvcmVzb2x2LmNvbmY= | base64 -d | sudo sh
    timeout == 60
  step "point pkg at the network repository"
    ssh == echo cHJpbnRmICclc1xuJyAnRnJlZUJTRDogeycgJyAgdXJsOiAicGtnK2h0dHBzOi8vcGtnLkZyZWVCU0Qub3JnLyR7QUJJfS9xdWFydGVybHkiLCcgJyAgbWlycm9yX3R5cGU6ICJzcnYiLCcgJyAgZW5hYmxlZDogeWVzJyAnfScgPiAvdXNyL2xvY2FsL2V0Yy9wa2cvcmVwb3MvRnJlZUJTRC5jb25m | base64 -d | sudo sh
    timeout == 60
  step "install xfce and the display manager"
    ssh == sudo env ASSUME_ALWAYS_YES=yes pkg install -y xorg xfce lightdm lightdm-gtk-greeter
    timeout == 5400
  step "prove xfce is installed"
    ssh == ls -l /usr/local/share/xsessions/xfce.desktop
    timeout == 120
  step "enable the display manager at boot"
    ssh == sudo sysrc lightdm_enable=YES
    timeout == 120
  step "enable dbus, without which there is no session"
    ssh == "sudo sysrc dbus_enable=YES\nsudo sysrc devfs_system_ruleset=desktop\nsudo pw groupmod video -m {{ user }}\nsysrc -a\n"
    timeout == 180
  step "set the account's password so PAM will authenticate it"
    ssh == "sudo sh -c 'cp=$(openssl passwd -6 -salt \"$(date +%s%N | tail -c 17)\" \"{{ password }}\") && pw usermod {{ user }} -H \"$cp\"'\nsudo grep \"^{{ user }}:\" /etc/master.passwd | cut -d: -f2 | cut -c1-3\n"
    timeout == 180
  step "prove the password is a hash and not a locked field"
    ssh == sh -c 'grep "^{{ user }}:" /etc/master.passwd | case "$(cat)" in *:*\$6\$*) echo HASH_SET ;; *) echo LOCKED ;; esac'
  step "point lightdm at the greeter and autologin"
    ssh == "sudo mkdir -p /usr/local/etc/lightdm\nsudo sh -c 'printf \"%s\\n\" \"[Seat:*]\" \"greeter-session=lightdm-gtk-greeter\" \"autologin-user={{ user }}\" \"autologin-user-timeout=0\" \"session-wrapper=/usr/local/etc/lightdm/Xsession\" \"user-session=xfce\" > /usr/local/etc/lightdm/lightdm.conf'\ncat /usr/local/etc/lightdm/lightdm.conf\n"
    timeout == 120
  step "prove lightdm will start"
    ssh == grep -c autologin-user /usr/local/etc/lightdm/lightdm.conf
    timeout == 120
  step "flush the writes before anything else"
    ssh == sudo sync
    timeout == 300
  step "flush the writes before the machine stops"
    ssh == sudo sync
    timeout == 300
  # `shutdown: acpi` WAS A VALUE THIS VOCABULARY DOES NOT HAVE, AND IT SURVIVED UNTIL THE STEP
  # BEFORE THE LAST ONE ON A REAL RUN.
  #
  # MEASURED on the run after the resolver fix let `pkg install xfce` succeed - step 17 of 18:
  #
  #	status: failed step 17/18 "stop the machine"
  #	error:   "acpi" is not a shutdown method; the ones this build has are `kill` and `ssh`.
  #	         To press the power button write `acpi: power`, to ask the guest agent write
  #	         `qga: shutdown`, ...
  #
  # So `shutdown:` is a method NAME (`kill`, `ssh`) and asking for the power button is the `acpi:`
  # ACTION. The `var shutdown` default was the old spelling and `freebsd.yml` never overrides it,
  # which is why nothing caught it: the value never appeared in a workflow.
  step "press the power button"
    acpi == power
    timeout == 60
  step "wait for the machine to stop"
    wait_until == stopped
    timeout == 600
  step "publish the disk"
    compress == '{{ out }}'
