walkthrough "freebsd 15.1 - the desktop is up"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var hostname
  default easyvm-freebsd
  from args.hostname
var locale
  default en_US.UTF-8
  from args.locale
var out
  default out/freebsd-vm-configure.qcow2
  from args.out
password admin
var timezone
  default America/Los_Angeles
  from args.timezone
var user
  default vmuser
  from args.user
ssh_port 2222


step "boot the disk"
  boot
  memory_mb 8192
  os bsd
  timeout 900

step "wait for sshd"
  require_ssh
  timeout 600

step "the session is running"
  ssh "sh -c 'pgrep -x lightdm >/dev/null && echo LIGHTDM_UP'"
  timeout 180

step "wait for the desktop"
  repeat
    pause 10
    until
      bind ready
      from desk
      mode text
      rect [0, 0, 117, 44]
      rect_at [1920, 1080]
      words [[applications], [desktop], [xfce]]
    max 40

step "the desktop is not a login prompt"
  read greeter

step "check there is no login prompt"
  expect
    from greeter
    mode text
    name no_prompt
    rect [0, 0, 117, 44]
    rect_at [1920, 1080]
    without [login, password]
    words [[applications]]

step "the guest agent answers, which is what makes a graceful shutdown possible"
  ssh "sh -c 'pgrep -f qemu-ga >/dev/null && readlink -f /dev/vtcon/org.qemu.guest_agent.0 && echo GUEST_AGENT_UP'"
  timeout 180

step "the agent's rc.conf line, which is what starts it at every boot"
  ssh "grep qemu_guest_agent /etc/rc.conf"
  timeout 60

step "set the machine's name"
  ssh "sh -c 'printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" sh -c \"sysrc hostname={{ hostname }} && hostname {{ hostname }}\"'"
  timeout 120

step "point the loopback line at that name"
  ssh "sh -c 'printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" sh -c \"grep -q \\\"{{ hostname }}\\\" /etc/hosts || printf \\\"127.0.1.1\\t{{ hostname }}\\n\\\" >> /etc/hosts\"'"
  timeout 60

step "prove the name"
  ssh "sh -c 'echo \"kernel = $(hostname)\"; echo \"rc.conf = $(sysrc -n hostname)\"; echo \"hosts = $(grep -c \"{{ hostname }}\" /etc/hosts) line(s)\"; test \"$(hostname)\" = \"{{ hostname }}\" && echo HOSTNAME_OK'"
  timeout 60

step "set the time zone"
  ssh "sh -c 'printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" sh -c \"tzsetup -s {{ timezone }}\" 2>&1 | tail -3'"
  timeout 120

step "prove the time zone"
  ssh "sh -c 'echo \"localtime = $(readlink -f /etc/localtime)\"; echo \"zoneinfo = $(cat /var/db/zoneinfo 2>/dev/null)\"; echo \"date = $(date)\"; grep -q \"{{ timezone }}\" /var/db/zoneinfo && echo TIMEZONE_OK'"
  timeout 60

step "set the locale in /etc/profile, which is what a login shell reads"
  ssh "sh -c 'printf \"%s\\n\" \"{{ password }}\" | sudo -S -p \"\" sh -c \"grep -q \\\"^LANG={{ locale }}\\\" /etc/profile || printf \\\"LANG={{ locale }}\\nLC_ALL={{ locale }}\\n\\\" >> /etc/profile\"'"
  timeout 120

step "add the locale to login.conf and rebuild its database"
  ssh "printf '%s\\n' '{{ password }}' | sudo -S -p '' sh -c 'if grep -q \"LANG={{ locale }}\" /etc/login.conf; then echo ALREADY_SET; else cp /etc/login.conf /etc/login.conf.easymv-bak; awk \"/:setenv=BLOCKSIZE=K:/ { if (seen == 0) { printf \\\"\\t:LANG={{ locale }}:\\\\\\\\\\n\\\"; seen = 1 } } { print }\" /etc/login.conf > /tmp/lc.new; test -s /tmp/lc.new && cp /tmp/lc.new /etc/login.conf && echo INSERTED; fi; cap_mkdb /etc/login.conf'"
  timeout 180

step "prove the locale in a new login shell, and in the login database"
  ssh "sh -c 'sh -lc \"printf \\\"LANG=%s\\nLC_ALL=%s\\n\\\" \\\"\\$LANG\\\" \\\"\\$LC_ALL\\\"\" 2>/dev/null | grep -E \"^(LANG|LC_ALL)=\" ; echo \"source file ---\" ; grep -c \"LANG={{ locale }}\" /etc/login.conf || true ; echo \"compiled database ---\" ; strings /etc/login.conf.db | grep -c \"LANG={{ locale }}\" || true'"
  timeout 120

step "prove the guest can fetch from the host share"
  ssh "sh -c 'curl -fsS --max-time 20 http://172.30.0.1:8080/shared/ 2>/dev/null || fetch -qo - http://172.30.0.1:8080/shared/'"
  timeout 180

step "flush the writes before anything else"
  ssh "sudo sync"
  timeout 300

  # `shutdown: acpi` IS NOT A METHOD, AND `freebsd.yml` NEVER PASSES `args.shutdown`, so this step
  # asked for the illegal value on every run.
  #
  # MEASURED on run 44448146157, the vm stage, step 19 of 20:
  #
  #	status: failed step 19/20 "stop the machine"
  #	error:   "acpi" is not a shutdown method; the ones this build has are `kill` and `ssh`.
  #	         To press the power button write `acpi: power`, ...
  #
  # THE SAME DEFECT WAS FIXED IN `ssh.walk` AND THIS FILE WAS MISSED - it is a separate file with its
  # own copy of the variable. The ending is now the two steps the error message recommends, the same
  # pair the ssh stage uses.
step "press the power button"
  acpi power
  timeout 60

step "wait for the machine to stop"
  wait_until stopped
  timeout 600

step "publish the disk"
    save "{{ out }}"
