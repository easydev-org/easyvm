walkthrough "freebsd 15.1 - bsdinstall, to an installed system"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin
var shutdown
  default kill
  from args.shutdown
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [freebsd.iso]

step "create the empty disk"
  disk disk.qcow2
  disk_gb 128

step "boot the installer"
  boot
  iso freebsd.iso
  memory_mb 8192
  os bsd
  timeout 1800

step "wait for the installer menu"
  repeat
    pause 10
    until
      bind menu_up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[install], [live, system]]
    max 60

step "welcome - Install is preselected"
  input ret
  settle 10

step "keymap - continue with the default"
  input ret
  settle 8
step "hostname"
  settle 2
  input text freebsd

step "accept the hostname"
  input ret
  settle 8

step "installation type - packages, which is pkgbase"
  input ret
  settle 10

step "offline, so pkgbase does not reboot before the chroot runs"
  do
    item
      input right
      settle 1
    item
      input ret
      settle 10

step "partitioning - automatic ufs"
  settle 12

step "wait for the partitioning menu before choosing on it"
  repeat
    pause 6
    until
      bind part_showing
      source partmenu
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [guided, manual]
    max 25

step "choose auto ufs"
  do
    item
      input down
      settle 1
    item
      input ret
      settle 10

step "entire disk, not a shared partition"
  input ret
  settle 10

step "partition scheme - GPT, which is what makes this disk UEFI bootable"
  input ret
  settle 10

step "wait for the partition editor"
  repeat
    pause 6
    until
      bind parted_showing
      source parted
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [finish, delete]
    max 25

step "accept the partitioning"
  do
    item
      input tab
      settle 1
    item
      input tab
      settle 1
    item
      input tab
      settle 1
    item
      input tab
      settle 1
    item
      input tab
      settle 1
    item
      input tab
      settle 1
    item
      input ret
      settle 10

step "commit the layout"
  input ret
  settle 15

step "distribution select - accept the default set"
  input ret
  settle 15

  # THE INSTALL ENDS BY ASKING FOR THE ROOT PASSWORD, AND THAT IS THE SIGNAL THE SCREEN GIVES.
  #
  # MEASURED ON RUN 44377971855, WHICH WAITED THE WHOLE 180 ATTEMPTS AND THEN FAILED:
  #
  #   status: failed step 20/62 "wait for the install to finish"
  #   error:  the loop ran 180 attempt(s) and the condition never held
  #
  # AND A SECOND RUN SHOWED THE OTHER HALF: the frame at 180 seconds was the package extractor at
  # 90 of 320 files - "Extracting FreeBSD-kernel-generic-15.1". THIS MEDIUM INSTALLS 320 PACKAGES
  # OFFLINE and 180 attempts of 15 seconds is 45 minutes, which is not enough for it on a runner.
  # So the ceiling is 400 attempts (100 minutes) as well as the words being right.
  #
  # and the frame from that run is already at the NEXT step - bsdinstall's "Set root password"
  # dialog, with "Please select a password for the system management account (root)". THE INSTALL
  # HAD FINISHED AND THE WALK DID NOT NOTICE, because the words it waited for ("installation
  # completed", "console") never appear on this screen: bsdinstall goes straight to the account
  # dialog, and the next step in this file types the password into it.
  #
  # SO THE DIALOG'S OWN TITLE IS AN ACCEPTED ANSWER. It is what the very next step assumes, so a
  # loop that ends here is a loop that agrees with the file.
step "wait for the install to finish"
  # THE REGION IS THE DIALOG, BECAUSE A WHOLE FRAME AT SCALE 3 LOSES ITS TEXT.
  #
  # MEASURED on the frame from run 44401975665: cropping the dialog and enlarging it 4x reads
  # "Please select a password for the system management account (root) / Password / Repeat
  # password" perfectly, while the WHOLE 1920x1080 frame at the default scale 3 reads exactly
  #
  #	tesseract: FreeBSD Installer
  #
  # and nothing else - 5760x3240 is past the point where the page segmenter finds the small grey
  # body text inside a large blue field. So the loop waited 100 minutes on a screen that had been
  # showing the dialog the whole time, and every word it looked for was on it.
  #
  # `rect` covers the dialog box; `scale: 4` is the enlargement that was measured to work.
  repeat
    pause 15
    until
      bind finished
      source done
      mode text
      rect [700, 420, 1200, 640]
      rect_at [1920, 1080]
      scale 4
      words [[root, password], [please, select, a, password], [installation, completed], [system, management, account], [manual, configuration]]
    max 400

step "the root password - first field"
  settle 2
  input text "{{ password }}"

step "the root password - tab to the second field"
  input tab
  settle 1

step "the root password - second field"
  settle 2
  input text "{{ password }}"

step "skip the root password pane"
  do
    item
      input tab
      settle 1
    item
      input tab
      settle 1
    item
      input right
      settle 1
    item
      input ret
      settle 8

step "network - auto, which is the interface menu's default button"
  input ret
  settle 15

step "time zone - the region list opens on UTC, which is the first entry"
  input ret
  settle 6

step "time zone - the date box, skipped"
  input ret
  settle 4

step "time zone - the time box, skipped"
  input ret
  settle 4

step "services - sshd is already ticked, so accept the list"
  input ret
  settle 6

step "hardening - nothing to hide on a throwaway guest, so accept"
  input ret
  settle 6

step "firmware - skip it"
  input ret
  settle 10

step "do not add a user here - the chroot shell does it"
  do
    item
      input left
      settle 1
    item
      input ret
      settle 8

step "final configuration - Finish is the first entry"
  input ret
  settle 10

step "open a shell in the new system"
  do
    item
      input left
      settle 1
    item
      input ret
      settle 12

step "prove the chroot shell is actually up before typing into it"
  repeat
    pause 5
    until
      bind shell_up
      source chroot
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [chroot]
    max 20

step "set the root password"
  do
    item
      settle 10
      input text "printf '%s' '{{ password }}' | pw usermod root -h0 && echo ROOT_PW_SET"
    item
      input ret

step "create the account"
  do
    item
      settle 10
      input text "pw useradd -n {{ user }} -m -s /bin/csh -G wheel"
    item
      input ret
    item
      settle 10
      input text "printf '%s' '{{ password }}' | pw usermod {{ user }} -h0 && echo PASSWORD_SET"
    item
      input ret

step "prove the account exists"
  do
    item
      settle 2
      input text "pw usershow {{ user }}"
    item
      input ret
      settle 4

step "allow password authentication over ssh"
  do
    item
      settle 3
      input text "sed -i '' 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config"
    item
      input ret
      settle 4

step "prove the setting took"
  do
    item
      settle 2
      input text "grep -c '^PasswordAuthentication yes' /etc/ssh/sshd_config"
    item
      input ret
      settle 4

step "make sure sshd starts at every boot"
  do
    item
      settle 2
      input text "sysrc sshd_enable=YES"
    item
      input ret
      settle 4

step "give the chroot a resolver, without which pkg cannot reach a mirror"
  do
    item
      settle 2
      input text "echo cHJpbnRmICclc1xuJyAnbmFtZXNlcnZlciAxNzIuMzAuMC4xJyA+IC9ldGMvcmVzb2x2LmNvbmY= | base64 -d | sh"
    item
      input ret
      settle 3
    item
      settle 3
      input text "cat /etc/resolv.conf"
    item
      input ret
      settle 5

step "point pkg at the network repository, because the disc has no ports packages"
  do
    item
      settle 5
      input text "echo cHJpbnRmICclc1xuJyAnRnJlZUJTRDogeycgJyAgdXJsOiAicGtnK2h0dHBzOi8vcGtnLkZyZWVCU0Qub3JnLyR7QUJJfS9xdWFydGVybHkiLCcgJyAgbWlycm9yX3R5cGU6ICJzcnYiLCcgJyAgZW5hYmxlZDogeWVzJyAnfScgPiAvdXNyL2xvY2FsL2V0Yy9wa2cvcmVwb3MvRnJlZUJTRC5jb25m | base64 -d | sh"
    item
      input ret
    item
      settle 3
      input text "cat /usr/local/etc/pkg/repos/FreeBSD.conf"
    item
      input ret

step "bootstrap pkg, which is a stub until it downloads itself once"
  do
    item
      settle 4
      input text "env ASSUME_ALWAYS_YES=yes pkg bootstrap -f"
    item
      input ret
      settle 60
    item
      settle 3
      input text "pkg -vv"
    item
      input ret
      settle 6

step "install the desktop, sudo and their packages while this shell is root"
  do
    item
      settle 4
      input text "env ASSUME_ALWAYS_YES=yes pkg install -y sudo xorg xf86-video-scfb xf86-input-libinput xfce lightdm lightdm-gtk-greeter"
    item
      input ret
      settle 60
    item
      settle 3
      input text "sh -c 'i=0; while [ $i -lt 60 ]; do pkg info xfce >/dev/null 2>&1 && pkg info sudo >/dev/null 2>&1 && break; sleep 10; i=$((i+1)); done; pkg info sudo xfce xorg lightdm 2>&1 | grep -E \"^(Name|Version)\" | head -8'"
    item
      input ret
      settle 40

step "prove the desktop actually landed"
  do
    item
      settle 3
      input text "ls -l /usr/local/share/xsessions/xfce.desktop /usr/local/bin/Xorg /usr/local/sbin/lightdm"
    item
      input ret
      settle 5
    item
      settle 2
      input text "ls -l /usr/local/bin/sudo"
    item
      input ret
      settle 4

step "let the account escalate without a password"
  do
    item
      settle 2
      input text "printf '%s\\n' '{{ user }} ALL=(ALL) NOPASSWD:ALL' > /usr/local/etc/sudoers.d/90-{{ user }}"
    item
      input ret
      settle 3
    item
      settle 2
      input text "chmod 0440 /usr/local/etc/sudoers.d/90-{{ user }}"
    item
      input ret
      settle 3

step "prove sudo works, as the account will use it"
  do
    item
      settle 3
      input text "su -m {{ user }} -c 'sudo -n id -un'"
    item
      input ret
      settle 6

step "install the guest agent, which is what lets the host shut this machine down"
  do
    item
      settle 4
      input text "env ASSUME_ALWAYS_YES=yes pkg install -y qemu-guest-agent"
    item
      input ret
      settle 45
    item
      settle 3
      input text "sh -c 'i=0; while [ $i -lt 40 ]; do pkg info qemu-guest-agent >/dev/null 2>&1 && break; sleep 5; i=$((i+1)); done; pkg info qemu-guest-agent 2>&1 | grep -E \"^(Name|Version)\"'"
    item
      input ret
      settle 20

step "prove the guest agent's device and enable it at every boot"
  do
    item
      settle 2
      input text "sysrc qemu_guest_agent_enable=YES"
    item
      input ret
      settle 4
    item
      settle 2
      input text "ls /usr/local/bin/qemu-ga /usr/local/etc/rc.d/qemu-guest-agent"
    item
      input ret
      settle 4
    item
      settle 2
      input text "grep qemu_guest_agent /etc/rc.conf"
    item
      input ret
      settle 4

step "tell Xorg to draw through the kernel framebuffer"
  do
    item
      settle 1
      input text "mkdir -p /usr/local/etc/X11/xorg.conf.d"
    item
      input ret
      settle 2
    item
      settle 2
      input text "sh -c 'printf \"%s\\n\" \"Section \\\"Device\\\"\" \"    Identifier \\\"Card0\\\"\" \"    Driver \\\"scfb\\\"\" \"EndSection\" > /usr/local/etc/X11/xorg.conf.d/10-scfb.conf'"
    item
      input ret
      settle 3
    item
      settle 2
      input text "cat /usr/local/etc/X11/xorg.conf.d/10-scfb.conf"
    item
      input ret
      settle 4

step "enable the desktop at boot"
  do
    item
      settle 2
      input text "sysrc dbus_enable=YES"
    item
      input ret
      settle 3
    item
      settle 2
      input text "sysrc lightdm_enable=YES"
    item
      input ret
      settle 3
    item
      settle 2
      input text "sysrc devfs_system_ruleset=desktop"
    item
      input ret
      settle 3

step "log in to the desktop automatically"
  do
    item
      settle 3
      input text "sh -c 'printf \"%s\\n\" \"[Seat:*]\" \"greeter-session=lightdm-gtk-greeter\" \"autologin-user={{ user }}\" \"session-wrapper=/usr/local/etc/lightdm/Xsession\" \"autologin-user-timeout=0\" \"user-session=xfce\" > /usr/local/etc/lightdm/lightdm.conf'"
    item
      input ret
      settle 4
    item
      settle 2
      input text "cat /usr/local/etc/lightdm/lightdm.conf"
    item
      input ret
      settle 4

step "let the account reach the display and the video devices"
  do
    item
      settle 2
      input text "pw groupmod video -m {{ user }}"
    item
      input ret
      settle 4

step "flush the writes before anything else"
  do
    item
      settle 3
      input text sync
    item
      input ret
      settle 20
    item
      settle 3
      input text sync
    item
      input ret
      settle 20

step "prove the disk is the filesystem this file asked for"
  do
    item
      settle 3
      input text "sh -c 'df -h / | tail -1; zpool list 2>&1 | head -2'"
    item
      input ret
      settle 6

step "make the installed system talk on the serial console"
  do
    item
      settle 3
      input text "printf '%s\\n' 'console=\"comconsole,vidconsole\"' 'boot_multicons=\"YES\"' 'boot_serial=\"YES\"' 'comconsole_speed=\"115200\"' > /boot/loader.conf"
    item
      input ret
      settle 4
    item
      settle 2
      input text "cat /boot/loader.conf"
    item
      input ret
      settle 4

step "give ttyu0 a login prompt, or the console is readable but not usable"
  do
    item
      settle 3
      input text "awk 'BEGIN{OFS=\"\\t\"} /^ttyu0/{print \"ttyu0\",\"\\\"/usr/libexec/getty std.115200\\\"\",\"vt100\",\"on\",\"secure\"; next} {print}' /etc/ttys > /tmp/ttys.new && cp /tmp/ttys.new /etc/ttys"
    item
      input ret
      settle 4

step "leave the shell, which finishes the install"
  do
    item
      settle 5
      input text exit
    item
      input ret
      settle 60

step "wait for the installer to unmount the disk"
  settle 120

step "stop the machine"
  stop "{{ shutdown }}"
  timeout 300

step "publish the disk"
    save "{{ out }}"
